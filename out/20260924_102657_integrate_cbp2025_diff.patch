--- /dev/null
+++ b/patch_final.py
@@ -0,0 +1,46 @@
+import re
+with open('my_cond_branch_predictor.h', 'r') as f:
+    text = f.read()
+
+# 1. Remove valid=false at decode
+text = text.replace('sR_RegTable[dest_reg].valid = false;', '//sR_RegTable[dest_reg].valid = false;')
+
+# 2. Add FP registers digest logic
+fp_logic = """uint32_t digest = 0;
+                    if (dest_reg < 32) {
+                        uint64_t t = val;
+                        int trailing = 0;
+                        if (t == 0) trailing = 64;
+                        else while ((t & 1) == 0) { trailing++; t >>= 1; }
+                        
+                        uint64_t l = val;
+                        int leading = 0;
+                        if (l == 0) leading = 64;
+                        else while ((l & (1ULL << 63)) == 0) { leading++; l <<= 1; }
+                        
+                        trailing = trailing > 63 ? 63 : trailing;
+                        leading = leading > 63 ? 63 : leading;
+                        
+                        uint32_t val6 = val & 0x3F;
+                        digest = (trailing << 6) | leading;
+                        digest ^= val6;
+                    } else if (dest_reg < 64) {
+                        uint64_t exp = (val >> 52) & 0x7FF;
+                        uint64_t sign = (val >> 63) & 0x1;
+                        digest = (sign << 11) | exp;
+                    }"""
+text = re.sub(r'uint32_t digest = 0;\s+if \(dest_reg < 32\) \{.*?(?=sR_RegTable\[dest_reg\]\.payload = digest)', fp_logic + '\n                    ', text, flags=re.DOTALL)
+
+# 3. Use better hash for chosen_idx
+better_hash = """uint32_t hash = PC ^ active_hist.ghist;
+                    hash ^= hash >> 13;
+                    hash ^= hash >> 7;
+                    int chosen_idx = hash % num_available;"""
+text = re.sub(r'int chosen_idx = [^;]+;', better_hash, text)
+
+# 4. Decay in predict_sr
+text = re.sub(r'for \(int r = 0; r < SR_NUM_LOGICAL_REGS; \+\+r\) \{\n\s*if \(sR_RegTable\[r\]\.decay_ctr > 0\) \{\n\s*sR_RegTable\[r\]\.decay_ctr--;\n\s*\} else if \(sR_RegTable\[r\]\.decay_ctr == 0\) \{\n\s*sR_RegTable\[r\]\.valid = false;\n\s*\}\n\s*\}', '', text)
+text = text.replace('active_hist.sr_inflight[r] = sR_RegTable[r].valid;', 'if (sR_RegTable[r].decay_ctr > 0) sR_RegTable[r].decay_ctr--; else sR_RegTable[r].valid = false;\n                active_hist.sr_inflight[r] = sR_RegTable[r].valid;')
+
+with open('my_cond_branch_predictor.h', 'w') as f:
+    f.write(text)
