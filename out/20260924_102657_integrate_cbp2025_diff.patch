+    
+    cond_predictor_impl.sR_UT0[0][u_idx0][0] = -1;
+    cond_predictor_impl.sR_UT0[0][u_idx0][8] = 5;
+
+    // Set WT differently for digest 111 vs 222
+    uint32_t w_idx0_222 = cond_predictor_impl.hash_wt(PC, 222, 0) % SR_WT0_ENTRIES;
+    cond_predictor_impl.sR_WT0[0][w_idx0_222] = 10;
+    
+    int sr = cond_predictor_impl.predict_sr(1, 0, PC);
+    
+    // It should choose reg 8, bank_sum = 10, sR = 10 * SR_USEFUL_MULTIPLIER = 10 * 3 = 30
+    assert(sr == 10 * SR_USEFUL_MULTIPLIER);
+
+    return 0;
+}
