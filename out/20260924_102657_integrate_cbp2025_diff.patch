+                        trailing = trailing > 63 ? 63 : trailing;
+                        leading = leading > 63 ? 63 : leading;
+                        
+                        uint32_t val6 = val & 0x3F;
+                        digest = (trailing & 0x3F) ^ ((leading & 0x3F) << 3) ^ (val6 << 6);
+                    } else if (dest_reg < 64) {
+                        digest = extract_fp_sign_and_exp(val) << 3;
+                    } else if (dest_reg == 64) {
+                        uint32_t val4 = val & 0xF;
+                        digest = val4 | (val4 << 4) | (val4 << 8);
+                    }
+                    
+                    sR_RegTable[dest_reg].payload = digest & 0xFFF;
+                    sR_RegTable[dest_reg].valid = true;
+                    sR_RegTable[dest_reg].decay_ctr = (1 << SR_DECAY_CTR_BITS) - 1;
+                }
+            }
+        }
+
+        int predict_sr(uint64_t seq_no, uint8_t piece, uint64_t PC)
+        {
+            if (!sr_enabled) return 0;
+            
+            for (int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+                active_hist.sr_inflight[r] = sR_RegTable[r].valid;
+            }
+            
+            int sR = 0;
+                                                for (int b = 0; b < SR_NUM_BANKS; ++b) {
+                uint32_t u_idx0 = hash_ut(PC, 0) % SR_UT0_ENTRIES;
+                uint32_t u_idx1 = hash_ut(PC, 1) % SR_UT1_ENTRIES;
+                uint32_t u_idx2 = hash_ut(PC, 2) % SR_UT2_ENTRIES;
+                
+                int max_u = -99999;
+                int best_reg = -1;
+                
+                for (int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+                    if ((r % SR_NUM_BANKS) == b && sR_RegTable[r].valid) {
+                        int u_sum = sR_UT0[b][u_idx0][r] + sR_UT1[b][u_idx1][r] + sR_UT2[b][u_idx2][r];
+                        if (u_sum > max_u) {
+                            max_u = u_sum;
+                            best_reg = r;
+                        }
+                    }
+                }
+                
+                int bank_sum = 0;
+                if (best_reg != -1) {
+                    uint32_t digest = sR_RegTable[best_reg].payload;
+                    uint32_t w_idx0 = hash_wt(PC, digest, 0) % SR_WT0_ENTRIES;
+                    uint32_t w_idx1 = hash_wt(PC, digest, 1) % SR_WT1_ENTRIES;
+                    uint32_t w_idx2 = hash_wt(PC, digest, 2) % SR_WT2_ENTRIES;
+                    bank_sum = sR_WT0[b][w_idx0] + sR_WT1[b][w_idx1] + sR_WT2[b][w_idx2];
+                }
+                
+                if (max_u > 0) {
+                    sR += (int)(bank_sum * SR_USEFUL_MULTIPLIER);
+                }
+            }
+            return sR;
+        }
+
+        void update_sr_weights(uint64_t seq_no, uint8_t piece, uint64_t PC, bool resolveDir)
+        {
+            if (!sr_enabled) return;
+            
+            uint64_t pred_hist_key = get_unique_inst_id(seq_no, piece);
+            if (pred_time_histories.find(pred_hist_key) == pred_time_histories.end()) return;
+            const auto& p_hist = pred_time_histories.at(pred_hist_key);
+            
+            for (int b = 0; b < SR_NUM_BANKS; ++b) {
+                int num_available = 0;
+                for (int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+                    if ((r % SR_NUM_BANKS) == b && p_hist.sr_inflight[r]) {
+                        num_available++;
+                    }
+                }
+                
+                if (num_available > 0) {
+                    int chosen_idx = rand() % num_available; 
+                    int current_idx = 0;
+                    int chosen_reg = 0;
+                    for (int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+                        if ((r % SR_NUM_BANKS) == b && p_hist.sr_inflight[r]) {
+                            if (current_idx == chosen_idx) {
+                                chosen_reg = r;
+                            }
+                            current_idx++;
+                        }
+                    }
+                    
+                    uint32_t u_idx0 = hash_ut(PC, 0) % SR_UT0_ENTRIES;
+                    uint32_t u_idx1 = hash_ut(PC, 1) % SR_UT1_ENTRIES;
+                    uint32_t u_idx2 = hash_ut(PC, 2) % SR_UT2_ENTRIES;
+                    
+                    uint32_t digest = sR_RegTable[chosen_reg].payload & 0xFFF;  
+                    uint32_t w_idx0 = hash_wt(PC, digest, 0) % SR_WT0_ENTRIES;
+                    uint32_t w_idx1 = hash_wt(PC, digest, 1) % SR_WT1_ENTRIES;
+                    uint32_t w_idx2 = hash_wt(PC, digest, 2) % SR_WT2_ENTRIES;
+                    
+                    int bank_sum = sR_WT0[b][w_idx0] + sR_WT1[b][w_idx1] + sR_WT2[b][w_idx2];
+                    bool bank_pred = bank_sum >= 0;
+                    int u_delta = (bank_pred == resolveDir) ? 1 : -1;
+                    
+                    sR_UT0[b][u_idx0][chosen_reg] = saturate(sR_UT0[b][u_idx0][chosen_reg] + u_delta, SR_WT_BITS);
+                    sR_UT1[b][u_idx1][chosen_reg] = saturate(sR_UT1[b][u_idx1][chosen_reg] + u_delta, SR_WT_BITS);
+                    sR_UT2[b][u_idx2][chosen_reg] = saturate(sR_UT2[b][u_idx2][chosen_reg] + u_delta, SR_WT_BITS);
+                    
+                    int w_delta = resolveDir ? 1 : -1;
+                    sR_WT0[b][w_idx0] = saturate(sR_WT0[b][w_idx0] + w_delta, SR_WT_BITS);
+                    sR_WT1[b][w_idx1] = saturate(sR_WT1[b][w_idx1] + w_delta, SR_WT_BITS);
+                    sR_WT2[b][w_idx2] = saturate(sR_WT2[b][w_idx2] + w_delta, SR_WT_BITS);
+                }
+            }
+        }
+
+    
+        void recover(uint32_t payload)
+        {
+            if (!sr_enabled) return;
+            for (int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+                if (!sR_RegTable[r].valid && sR_RegTable[r].payload == payload) {
+                    sR_RegTable[r].payload = 0;
+                }
+            }
+        }
+
+    private:
+        int saturate(int val, int bits) {
+            int max_val = (1 << (bits - 1)) - 1;
+            int min_val = -(1 << (bits - 1));
+            if (val > max_val) return max_val;
+            if (val < min_val) return min_val;
+            return val;
+        }
+
+        uint32_t hash_ut(uint64_t PC, int table) {
+            PC ^= PC >> (table + 1);
+            return (uint32_t)PC;
+        }
+
+        uint32_t hash_wt(uint64_t PC, uint32_t digest, int table) {
+            return (uint32_t)(PC ^ (digest << table));
+        }
+};
+
+extern SampleCondPredictor cond_predictor_impl;
+#endif
