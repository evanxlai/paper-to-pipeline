diff --git a/patch_rand.py b/patch_rand.py
new file mode 100644
index 0000000..59ed0e2
--- /dev/null
+++ b/patch_rand.py
@@ -0,0 +1,8 @@
+import re
+with open('my_cond_branch_predictor.h', 'r') as f:
+    text = f.read()
+
+text = text.replace('int chosen_idx = rand() % num_available;', 'int chosen_idx = (PC ^ p_hist.ghist) % num_available;')
+
+with open('my_cond_branch_predictor.h', 'w') as f:
+    f.write(text)
diff --git a/patch_recover.py b/patch_recover.py
new file mode 100644
index 0000000..6e78426
--- /dev/null
+++ b/patch_recover.py
@@ -0,0 +1,20 @@
+import re
+
+with open('my_cond_branch_predictor.h', 'r') as f:
+    text = f.read()
+
+recover_method = """
+        void recover(uint32_t payload)
+        {
+            if (!sr_enabled) return;
+            for (int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+                if (!sR_RegTable[r].valid && sR_RegTable[r].payload == payload) {
+                    sR_RegTable[r].payload = 0;
+                }
+            }
+        }
+"""
+text = text.replace('private:', recover_method + '\n    private:')
+
+with open('my_cond_branch_predictor.h', 'w') as f:
+    f.write(text)
diff --git a/patch_s1.py b/patch_s1.py
new file mode 100644
index 0000000..b1a0b60
--- /dev/null
+++ b/patch_s1.py
@@ -0,0 +1,26 @@
+import re
+with open('cbp2016_tage_sc_l.h', 'r') as f:
+    text = f.read()
+
+text = text.replace('#include <inttypes.h>', '#include <inttypes.h>\n#include "sr_params.h"')
+
+macro_replacements = {
+    '#define LOGG 10': '#define LOGG HOST_LOGG',
+    '#define LOGL 15': '#define LOGL HOST_LOGL',
+    '#define LOGGNB 9': '#define LOGGNB HOST_LOGGNB',
+    '#define LOGPNB 9': '#define LOGPNB HOST_LOGPNB',
+    '#define LOGLNB 10': '#define LOGLNB HOST_LOGLNB',
+    '#define LOGSNB 10': '#define LOGSNB HOST_LOGSNB',
+    '#define LOGTNB 10': '#define LOGTNB HOST_LOGTNB',
+    '#define LOGIMNB 9': '#define LOGIMNB HOST_LOGIMNB',
+    '#define LOGINB 9': '#define LOGINB HOST_LOGINB',
+    '#define LOGBIAS 8': '#define LOGBIAS HOST_LOGBIAS',
+    '#define LOGBIASSK 8': '#define LOGBIASSK HOST_LOGBIASSK',
+    '#define LOGBIASBANK 7': '#define LOGBIASBANK HOST_LOGBIASBANK'
+}
+
+for k, v in macro_replacements.items():
+    text = text.replace(k, v)
+
