--- /dev/null
+++ b/sr_params.h
@@ -0,0 +1,63 @@
+// generated from the feature spec and the port plan; DSE mutates values only
+#pragma once
+#define SR_NUM_BANKS 8  // range: [1, 16]
+#define SR_NUM_LOGICAL_REGS 65  // range: [1, 256]
+#define SR_WT0_ENTRIES 512  // range: [2, 65536] pow2
+#define SR_WT1_ENTRIES 256  // range: [2, 65536] pow2
+#define SR_WT2_ENTRIES 128  // range: [2, 65536] pow2
+#define SR_UT0_ENTRIES 8  // range: [2, 65536] pow2
+#define SR_UT1_ENTRIES 8  // range: [2, 65536] pow2
+#define SR_UT2_ENTRIES 8  // range: [2, 65536] pow2
+#define SR_WT_BITS 6  // range: [1, 16]
+#define SR_DECAY_CTR_BITS 8  // range: [1, 16]
+#define SR_ROB_IDX_BITS 14  // range: [1, 32]
+#define SR_INFLIGHT_BRANCHES 256  // range: [1, 1024]
+#define SR_USEFUL_MULTIPLIER 2.5  // range: [1.0, 4.0]
+#define SR_ALGORITHMS_1_PSEUDOCODE_VARIANT 0  // range: index 0-2 (0=saturate | 1=modulo | 2=match_sign)
+#define SR_ALGORITHMS_2_PSEUDOCODE_VARIANT 0  // range: index 0-1 (0=stride_interleaved | 1=contiguous_blocks)
+#define SR_ALGORITHMS_3_TRIGGER_VARIANT 0  // range: index 0-1 (0=commit | 1=resolve)
+#define SR_ALGORITHMS_1_PSEUDOCODE_VARIANT_2 0  // range: index 0-1 (0=align_bit_3 | 1=align_bit_0)
+#define SR_ALGORITHMS_2_VARIANT 0  // range: index 0-1 (0=max_u_greater_than_zero | 1=always_2_5)
+// host knobs: the host's own structures, at the clean tree's values by default
+#define HOST_LOGG 10  // range: [7, 12]; sets LOGG
+#define HOST_TBITS 8  // range: [4, 16]; sets TBITS
+#define HOST_NBANKLOW 10  // range: [2, 16]; sets NBANKLOW
+#define HOST_NBANKHIGH 20  // range: [10, 30]; sets NBANKHIGH
+#define HOST_CWIDTH 3  // range: [2, 5]; sets CWIDTH
+#define HOST_UWIDTH 1  // range: [1, 3]; sets UWIDTH
+#define HOST_LOGB 13  // range: [10, 16]; sets LOGB
+#define HOST_HYSTSHIFT 2  // range: [1, 4]; sets HYSTSHIFT
+#define HOST_PERCWIDTH 6  // range: [4, 8]; sets PERCWIDTH
+#define HOST_LOGBIAS 8  // range: [4, 12]; sets LOGBIAS
+#define HOST_LOGGNB 10  // range: [2, 12]; sets LOGGNB
+#define HOST_LOGPNB 9  // range: [2, 12]; sets LOGPNB
+#define HOST_LOGLNB 10  // range: [2, 12]; sets LOGLNB
+#define HOST_LOGSNB 9  // range: [2, 12]; sets LOGSNB
+#define HOST_LOGTNB 10  // range: [2, 12]; sets LOGTNB
+#define HOST_LOGINB 8  // range: [2, 12]; sets LOGINB
+#define HOST_LOGIMNB 9  // range: [2, 12]; sets LOGIMNB
+#define HOST_LOGL 5  // range: [2, 10]; sets LOGL
+#define HOST_EWIDTH 6  // range: [4, 8]; sets EWIDTH
+// storage_bits is the sum of these, in bits:
+//   sR_WT: SR_NUM_BANKS * (SR_WT0_ENTRIES + SR_WT1_ENTRIES + SR_WT2_ENTRIES) * SR_WT_BITS
+//   sR_UT: SR_NUM_LOGICAL_REGS * (SR_UT0_ENTRIES + SR_UT1_ENTRIES + SR_UT2_ENTRIES) * SR_WT_BITS
+//   sR_RegTable: SR_NUM_LOGICAL_REGS * (1 + max(SR_ROB_IDX_BITS, 12) + SR_DECAY_CTR_BITS)
+//   sR_InFlightState: SR_INFLIGHT_BRANCHES * SR_NUM_LOGICAL_REGS
+//   host tagged tables, high banks: HOST_NBANKHIGH * 2 ** HOST_LOGG * (HOST_CWIDTH + HOST_UWIDTH + HOST_TBITS + 4)
+//   host tagged tables, low banks: HOST_NBANKLOW * 2 ** HOST_LOGG * (HOST_CWIDTH + HOST_UWIDTH + HOST_TBITS)
+//   host use-alt-on-NA counters: 16 * 5
+//   host bimodal, with shared hysteresis: 2 ** HOST_LOGB + 2 ** (HOST_LOGB - HOST_HYSTSHIFT)
+//   host global history: 3000
+//   host path history: 27
+//   host TICK counter: 10
+//   host loop predictor: 2 ** HOST_LOGL * (2 * 10 + 10 + 4 + 4 + 1)
+//   host loop predictor, counted again inside SC: 2 ** HOST_LOGL * (2 * 10 + 10 + 4 + 4 + 1)
+//   host SC thresholds and component weights: 12 + 8 * 64 + 3 * HOST_EWIDTH * 8
+//   host SC bias tables: HOST_PERCWIDTH * 3 * 2 ** HOST_LOGBIAS
+//   host SC global GEHL: (3 - 2) * 2 ** HOST_LOGGNB * HOST_PERCWIDTH + 2 ** (HOST_LOGGNB - 1) * 2 * HOST_PERCWIDTH + 40
+//   host SC path GEHL: (3 - 2) * 2 ** HOST_LOGPNB * HOST_PERCWIDTH + 2 ** (HOST_LOGPNB - 1) * 2 * HOST_PERCWIDTH
+//   host SC first local: (3 - 2) * 2 ** HOST_LOGLNB * HOST_PERCWIDTH + 2 ** (HOST_LOGLNB - 1) * 2 * HOST_PERCWIDTH + 256 * 11 + HOST_EWIDTH * 8
+//   host SC second local: (3 - 2) * 2 ** HOST_LOGSNB * HOST_PERCWIDTH + 2 ** (HOST_LOGSNB - 1) * 2 * HOST_PERCWIDTH + 16 * 16 + HOST_EWIDTH * 8
+//   host SC third local: 0 * 2 ** HOST_LOGTNB * HOST_PERCWIDTH + 2 ** (HOST_LOGTNB - 1) * 2 * HOST_PERCWIDTH + 16 * 9 + HOST_EWIDTH * 8
+//   host SC IMLI: 2 ** (HOST_LOGINB - 1) * HOST_PERCWIDTH + 8 + 2 * 2 ** (HOST_LOGIMNB - 1) * HOST_PERCWIDTH + 2 * HOST_EWIDTH * 8 + 256 * 10
+//   host chooser counters: 2 * 7
