+import os
+import re
+
+with open('cbp2016_tage_sc_l.h', 'r') as f:
+    content = f.read()
+
+# Insert #include "sr_params.h" at the top, just after the first #define or #include
+content = content.replace('#include <stdlib.h>', '#include <stdlib.h>\n#include "sr_params.h"')
+
+replacements = {
+    'LOGG': 10,
+    'TBITS': 8,
+    'NBANKLOW': 10,
+    'NBANKHIGH': 20,
+    'CWIDTH': 3,
+    'UWIDTH': 1,
+    'LOGB': 13,
+    'HYSTSHIFT': 2,
+    'PERCWIDTH': 6,
+    'LOGBIAS': 8,
+    'LOGGNB': 10,
+    'LOGPNB': 9,
+    'LOGLNB': 10,
+    'LOGSNB': 9,
+    'LOGTNB': 10,
+    'LOGINB': 8,
+    'LOGIMNB': 9,
+    'LOGL': 5,
+    'EWIDTH': 6
+}
+
+for knob, val in replacements.items():
+    content = re.sub(rf'#define\s+{knob}\s+{val}', f'#define {knob} HOST_{knob}', content)
+
+with open('cbp2016_tage_sc_l.h', 'w') as f:
