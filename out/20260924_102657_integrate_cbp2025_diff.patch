+
+#include <cassert>
+#include <stdlib.h>
+#define private public
+#define protected public
+#include "my_cond_branch_predictor.h"
+
+int main() {
+    setenv("SR_SR_ENABLE", "1", 1);
+    cond_predictor_impl.setup();
+
+    // registers 0, 4, 8, 12 in bank 0
+    cond_predictor_impl.sR_RegTable[0].valid = true;
+    cond_predictor_impl.sR_RegTable[4].valid = true;
+    cond_predictor_impl.sR_RegTable[8].valid = true;
+    cond_predictor_impl.sR_RegTable[12].valid = true;
+
+    uint64_t PC = 0x1000;
+    cond_predictor_impl.predict_sr(1, 0, PC);
+    cond_predictor_impl.predict(1, 0, PC, false);
+
+    // Call update multiple times to observe randomness, but for unit test, just one call
+    cond_predictor_impl.update_sr_weights(1, 0, PC, true);
+
+    // One of them should have UT updated
+    int num_updated = 0;
+    uint32_t u_idx0 = cond_predictor_impl.hash_ut(PC, 0) % SR_UT0_ENTRIES;
+    for (int r=0; r<SR_NUM_LOGICAL_REGS; ++r) {
+        if (cond_predictor_impl.sR_UT0[0][u_idx0][r] != 0) {
+            num_updated++;
+        }
+    }
+    // Only one register updated in bank 0
+    if(num_updated != 1) { printf("num_updated=%d\n", num_updated); exit(1); }
+
+    return 0;
+}
