+import subprocess
+import base64
+import re
+
+# 1. Regenerate my_cond_branch_predictor.h
+cmd = "python3 /home/laievan/cbp2025_port/make_pred.py"
+res = subprocess.run(cmd, shell=True, capture_output=True, text=True)
+with open('/home/laievan/cbp2025_port/my_cond_branch_predictor.h', 'wb') as f:
+    f.write(base64.b64decode(res.stdout))
+
+with open('/home/laievan/cbp2025_port/my_cond_branch_predictor.h', 'r') as f:
+    text = f.read()
+
+# 2. Add public: at the top of class SampleCondPredictor
+text = text.replace('class SampleCondPredictor\n{', 'class SampleCondPredictor\n{\n    public:')
+
+# 3. Add sr_payloads to SampleHist
+text = text.replace('std::bitset<SR_NUM_LOGICAL_REGS> sr_inflight;', 'std::bitset<SR_NUM_LOGICAL_REGS> sr_inflight;\n      uint32_t sr_payloads[SR_NUM_LOGICAL_REGS];')
+text = text.replace('sr_inflight.reset();', 'sr_inflight.reset();\n          for(int i=0; i<SR_NUM_LOGICAL_REGS; ++i) sr_payloads[i] = 0;')
+
+# 4. Add sr_payloads assignment in predict_sr
+text = text.replace('active_hist.sr_inflight[r] = sR_RegTable[r].valid;', 'active_hist.sr_inflight[r] = sR_RegTable[r].valid;\n                active_hist.sr_payloads[r] = sR_RegTable[r].payload;')
+
+# 5. Use sr_payloads in update_sr_weights
+text = text.replace('uint32_t digest = sR_RegTable[chosen_reg].payload;', 'uint32_t digest = p_hist.sr_payloads[chosen_reg] & 0xFFF;')
+
+# 6. Replace rand()
+better_hash = """uint32_t hash = PC ^ p_hist.ghist;
+                    hash ^= hash >> 13;
+                    hash ^= hash >> 7;
+                    int chosen_idx = hash % num_available;"""
+text = re.sub(r'int chosen_idx = rand\(\) % num_available;', better_hash, text)
+
+# 7. Add recover
+recover_method = """
+        void recover(uint32_t payload)
+        {
+            if (!sr_enabled) return;
+            for (int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+                if (!sR_RegTable[r].valid && sR_RegTable[r].payload == payload) {
+                    sR_RegTable[r].payload = 0;
+                }
+            }
+        }
+"""
+text = text.replace('public:\n\n        SampleCondPredictor (void)', 'public:\n' + recover_method + '\n        SampleCondPredictor (void)')
+
+with open('/home/laievan/cbp2025_port/my_cond_branch_predictor.h', 'w') as f:
+    f.write(text)
+
+print("Patched my_cond_branch_predictor.h!")
