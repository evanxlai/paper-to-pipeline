diff --git a/make_pred.py b/make_pred.py
new file mode 100644
index 0000000..f91acf9
--- /dev/null
+++ b/make_pred.py
@@ -0,0 +1,301 @@
+import sys
+
+content = """
+#ifndef _PREDICTOR_H_
+#define _PREDICTOR_H_
+
+#include <stdlib.h>
+#include <bitset>
+#include <unordered_map>
+#include "sr_params.h"
+
+struct SampleHist
+{
+      uint64_t ghist;
+      bool tage_pred;
+      std::bitset<SR_NUM_LOGICAL_REGS> sr_inflight;
+      
+      SampleHist()
+      {
+          ghist = 0;
+          sr_inflight.reset();
+      }
+};
+
+struct sR_RegTableEntry {
+    bool valid;
+    uint32_t payload;
+    uint32_t decay_ctr;
+};
+
+class SampleCondPredictor
+{
+        SampleHist active_hist;
+        std::unordered_map<uint64_t, SampleHist> pred_time_histories;
+        
+        bool sr_enabled;
+        
+        int sR_WT0[SR_NUM_BANKS][SR_WT0_ENTRIES];
+        int sR_WT1[SR_NUM_BANKS][SR_WT1_ENTRIES];
+        int sR_WT2[SR_NUM_BANKS][SR_WT2_ENTRIES];
+
+        int sR_UT0[SR_NUM_BANKS][SR_UT0_ENTRIES][SR_NUM_LOGICAL_REGS];
+        int sR_UT1[SR_NUM_BANKS][SR_UT1_ENTRIES][SR_NUM_LOGICAL_REGS];
+        int sR_UT2[SR_NUM_BANKS][SR_UT2_ENTRIES][SR_NUM_LOGICAL_REGS];
+
+        sR_RegTableEntry sR_RegTable[SR_NUM_LOGICAL_REGS];
+
+    public:
+
+        SampleCondPredictor (void)
+        {
+        }
+
+        void setup()
+        {
+            const char* e = getenv("SR_SR_ENABLE");
+            sr_enabled = (e != nullptr && e[0] == '1');
+            
+            if (sr_enabled) {
+                for (int b=0; b<SR_NUM_BANKS; ++b) {
+                    for (int i=0; i<SR_WT0_ENTRIES; ++i) sR_WT0[b][i] = 0;
+                    for (int i=0; i<SR_WT1_ENTRIES; ++i) sR_WT1[b][i] = 0;
+                    for (int i=0; i<SR_WT2_ENTRIES; ++i) sR_WT2[b][i] = 0;
+                    
+                    for (int i=0; i<SR_UT0_ENTRIES; ++i)
+                        for(int r=0; r<SR_NUM_LOGICAL_REGS; ++r) sR_UT0[b][i][r] = 0;
+                    for (int i=0; i<SR_UT1_ENTRIES; ++i)
+                        for(int r=0; r<SR_NUM_LOGICAL_REGS; ++r) sR_UT1[b][i][r] = 0;
+                    for (int i=0; i<SR_UT2_ENTRIES; ++i)
+                        for(int r=0; r<SR_NUM_LOGICAL_REGS; ++r) sR_UT2[b][i][r] = 0;
+                }
+                for (int r=0; r<SR_NUM_LOGICAL_REGS; ++r) {
+                    sR_RegTable[r].valid = false;
+                    sR_RegTable[r].payload = 0;
+                    sR_RegTable[r].decay_ctr = 0;
+                }
+            }
+        }
+
+        void terminate()
+        {
+        }
+
+        uint64_t get_unique_inst_id(uint64_t seq_no, uint8_t piece) const
+        {
+            return (seq_no << 4) | (piece & 0x000F);
+        }
+
+        bool predict (uint64_t seq_no, uint8_t piece, uint64_t PC, const bool tage_pred)
+        {
+            active_hist.tage_pred = tage_pred;
+            pred_time_histories.emplace(get_unique_inst_id(seq_no, piece), active_hist);
+            const bool pred_taken = predict_using_given_hist(seq_no, piece, PC, active_hist, true);
+            return pred_taken;
+        }
+
+        bool predict_using_given_hist (uint64_t seq_no, uint8_t piece, uint64_t PC, const SampleHist& hist_to_use, const bool pred_time_predict)
+        {
+            return hist_to_use.tage_pred;
+        }
+
+        void history_update (uint64_t seq_no, uint8_t piece, uint64_t PC, bool taken, uint64_t nextPC)
+        {
+            active_hist.ghist = active_hist.ghist << 1;
+            if(taken)
+            {
+                active_hist.ghist |= 1;
+            }
+        }
+
+        void update (uint64_t seq_no, uint8_t piece, uint64_t PC, bool resolveDir, bool predDir, uint64_t nextPC)
+        {
+            const auto pred_hist_key = get_unique_inst_id(seq_no, piece);
+            if(pred_time_histories.find(pred_hist_key) == pred_time_histories.end()) return;
+            const auto& pred_time_history = pred_time_histories.at(pred_hist_key);
+            update(PC, resolveDir, predDir, nextPC, pred_time_history);
+            pred_time_histories.erase(pred_hist_key);
+        }
+
+        void update (uint64_t PC, bool resolveDir, bool pred_taken, uint64_t nextPC, const SampleHist& hist_to_use)
+        {
+        }
+
+        void allocate_register(uint64_t seq_no, uint8_t piece, int dest_reg)
+        {
+            if (!sr_enabled) return;
+            for (int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+                if (sR_RegTable[r].decay_ctr > 0) {
+                    sR_RegTable[r].decay_ctr--;
+                } else if (sR_RegTable[r].decay_ctr == 0) {
+                    sR_RegTable[r].valid = false;
+                }
+            }
+            if (dest_reg >= 0 && dest_reg < SR_NUM_LOGICAL_REGS) {
+                sR_RegTable[dest_reg].valid = false;
+                sR_RegTable[dest_reg].payload = get_unique_inst_id(seq_no, piece);
+            }
+        }
+
+        uint32_t extract_fp_sign_and_exp(uint64_t val) {
+            return (val >> 55) & 0x1FF;
+        }
+
+        void write_register_digest(uint64_t seq_no, uint8_t piece, int dest_reg, uint64_t val)
+        {
+            if (!sr_enabled) return;
+            if (dest_reg >= 0 && dest_reg < SR_NUM_LOGICAL_REGS) {
+                if (!sR_RegTable[dest_reg].valid && sR_RegTable[dest_reg].payload == get_unique_inst_id(seq_no, piece)) {
+                    uint32_t digest = 0;
+                    if (dest_reg < 32) {
+                        uint64_t t = val;
+                        int trailing = 0;
+                        if (t == 0) trailing = 64;
+                        else while ((t & 1) == 0) { trailing++; t >>= 1; }
+                        
+                        uint64_t l = val;
+                        int leading = 0;
+                        if (l == 0) leading = 64;
+                        else while ((l & (1ULL << 63)) == 0) { leading++; l <<= 1; }
+                        
+                        trailing = trailing > 63 ? 63 : trailing;
+                        leading = leading > 63 ? 63 : leading;
+                        
+                        uint32_t val6 = val & 0x3F;
+                        digest = (trailing & 0x3F) ^ ((leading & 0x3F) << 3) ^ (val6 << 6);
+                    } else if (dest_reg < 64) {
+                        digest = extract_fp_sign_and_exp(val) << 3;
+                    } else if (dest_reg == 64) {
+                        uint32_t val4 = val & 0xF;
+                        digest = val4 | (val4 << 4) | (val4 << 8);
+                    }
+                    
+                    sR_RegTable[dest_reg].payload = digest & 0xFFF;
+                    sR_RegTable[dest_reg].valid = true;
+                    sR_RegTable[dest_reg].decay_ctr = (1 << SR_DECAY_CTR_BITS) - 1;
+                }
+            }
+        }
+
+        int predict_sr(uint64_t seq_no, uint8_t piece, uint64_t PC)
+        {
+            if (!sr_enabled) return 0;
+            
+            for (int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+                active_hist.sr_inflight[r] = sR_RegTable[r].valid;
+            }
+            
+            int sR = 0;
+            for (int b = 0; b < SR_NUM_BANKS; ++b) {
+                uint32_t u_idx0 = hash_ut(PC, 0) % SR_UT0_ENTRIES;
+                uint32_t u_idx1 = hash_ut(PC, 1) % SR_UT1_ENTRIES;
+                uint32_t u_idx2 = hash_ut(PC, 2) % SR_UT2_ENTRIES;
+                
+                int max_u = -99999;
+                int best_reg = -1;
+                
+                for (int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+                    if ((r % SR_NUM_BANKS) == b && sR_RegTable[r].valid) {
+                        int u_sum = sR_UT0[b][u_idx0][r] + sR_UT1[b][u_idx1][r] + sR_UT2[b][u_idx2][r];
+                        if (u_sum > max_u) {
+                            max_u = u_sum;
+                            best_reg = r;
+                        }
+                    }
+                }
+                
+                int bank_sum = 0;
+                if (best_reg != -1) {
+                    uint32_t digest = sR_RegTable[best_reg].payload;
+                    uint32_t w_idx0 = hash_wt(PC, digest, 0) % SR_WT0_ENTRIES;
+                    uint32_t w_idx1 = hash_wt(PC, digest, 1) % SR_WT1_ENTRIES;
+                    uint32_t w_idx2 = hash_wt(PC, digest, 2) % SR_WT2_ENTRIES;
+                    bank_sum = sR_WT0[b][w_idx0] + sR_WT1[b][w_idx1] + sR_WT2[b][w_idx2];
+                }
+                
+                if (max_u > 0) {
+                    sR += (int)(bank_sum * SR_USEFUL_MULTIPLIER);
+                }
+            }
+            return sR;
+        }
+
+        void update_sr_weights(uint64_t seq_no, uint8_t piece, uint64_t PC, bool resolveDir)
+        {
+            if (!sr_enabled) return;
+            
+            uint64_t pred_hist_key = get_unique_inst_id(seq_no, piece);
+            if (pred_time_histories.find(pred_hist_key) == pred_time_histories.end()) return;
+            const auto& p_hist = pred_time_histories.at(pred_hist_key);
+            
+            for (int b = 0; b < SR_NUM_BANKS; ++b) {
+                int num_available = 0;
+                for (int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+                    if ((r % SR_NUM_BANKS) == b && p_hist.sr_inflight[r]) {
+                        num_available++;
+                    }
+                }
+                
+                if (num_available > 0) {
+                    int chosen_idx = rand() % num_available; 
+                    int current_idx = 0;
+                    int chosen_reg = 0;
+                    for (int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+                        if ((r % SR_NUM_BANKS) == b && p_hist.sr_inflight[r]) {
+                            if (current_idx == chosen_idx) {
+                                chosen_reg = r;
+                            }
+                            current_idx++;
+                        }
+                    }
+                    
+                    uint32_t u_idx0 = hash_ut(PC, 0) % SR_UT0_ENTRIES;
+                    uint32_t u_idx1 = hash_ut(PC, 1) % SR_UT1_ENTRIES;
+                    uint32_t u_idx2 = hash_ut(PC, 2) % SR_UT2_ENTRIES;
+                    
+                    uint32_t digest = sR_RegTable[chosen_reg].payload; 
+                    uint32_t w_idx0 = hash_wt(PC, digest, 0) % SR_WT0_ENTRIES;
+                    uint32_t w_idx1 = hash_wt(PC, digest, 1) % SR_WT1_ENTRIES;
