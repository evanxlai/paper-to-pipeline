+                        for (int i = 0; i < SR_NUM_ENTRIES; i++) { if (wpt[i].tag == tag_val) { entry_idx = i; break; } }
+                        if (entry_idx != -1) { wpt[entry_idx].ranking = std::min(wpt[entry_idx].ranking + 1, (1 << SR_RANK_BITS) - 1); }
+                        else {
+                            int32_t min_rank = (1 << SR_RANK_BITS); int32_t replace_idx = 0;
+                            for (int i = 0; i < SR_NUM_ENTRIES; i++) { if (wpt[i].ranking < min_rank) { min_rank = wpt[i].ranking; replace_idx = i; } }
+                            auto& entry = wpt[replace_idx]; entry.tag = tag_val; entry.conf = 0; entry.ranking = 0;
+                            
+                            entry.length = std::min((int)meta.lptotal, (1 << SR_LENGTH_BITS) - 1);
