+#include <iostream>
+#include <cassert>
+#include "lib/sim_common_structs.h"
+#include "cbp2016_tage_sc_l.h"
+#include "my_cond_branch_predictor.h"
+
+int main() {
+    setenv("SR_WORMHOLE_ENABLE", "1", 1);
+    
+    // ut_alloc
+    {
+        SampleCondPredictor p;
+        p.setup();
+        
+        uint64_t PC = 0x1000;
+        uint64_t seq_no = 1;
+        uint8_t piece = 0;
+        
+        for(int i=0; i<3; i++) {
+            p.predict(seq_no, piece, PC, true); 
+            p.history_update(seq_no, piece, PC, false, PC+4);
+            p.update(seq_no, piece, PC, false, true, PC+4); 
+            seq_no++;
+        }
+        
+        cbp2016_tage_sc_l.LHIT = 0;
+        cbp2016_tage_sc_l.active_hist.ltable.resize(1);
+        cbp2016_tage_sc_l.active_hist.ltable[0].NbIter = 4;
+        
+        bool pred = p.predict(seq_no, piece, PC, true);
+        p.history_update(seq_no, piece, PC, true, PC+4);
+        p.update(seq_no, piece, PC, true, pred, PC+4);
+        seq_no++;
+        
+        cbp2016_tage_sc_l.LHIT = -1; // cached should be used if IMLI != 0
+        cbp2016_tage_sc_l.active_hist.IMLIcount = 1;
+        
+        bool pred2 = p.predict(seq_no, piece, PC, true);
+        assert(pred2 == true);
+    }
+    
+    // ut_walk
+    {
+        SampleCondPredictor p;
+        p.setup();
+        
+        uint64_t PC = 0x2000;
+        uint64_t seq_no = 100;
+        uint8_t piece = 0;
+        
+        for(int i=0; i<3; i++) {
+            p.predict(seq_no, piece, PC, true);
+            p.history_update(seq_no, piece, PC, false, PC+4);
+            p.update(seq_no, piece, PC, false, true, PC+4);
+            seq_no++;
+        }
+        
+        cbp2016_tage_sc_l.LHIT = 0;
+        cbp2016_tage_sc_l.active_hist.ltable.resize(1);
+        cbp2016_tage_sc_l.active_hist.ltable[0].NbIter = 4;
+        
+        p.predict(seq_no, piece, PC, true);
+        p.history_update(seq_no, piece, PC, false, PC+4);
+        p.update(seq_no, piece, PC, false, true, PC+4);
+        seq_no++;
+        
+        for (int i=0; i<16; i++) {
+            bool pred = p.predict(seq_no, piece, PC, true);
+            p.history_update(seq_no, piece, PC, false, PC+4);
+            p.update(seq_no, piece, PC, false, pred, PC+4);
+            seq_no++;
+        }
+    }
+    
+    // ut_recover
+    {
+        SampleCondPredictor p;
+        p.setup();
+        uint64_t PC = 0x3000;
