+import os
+import subprocess
+
+code = open("my_cond_branch_predictor.h").read()
+code = code.replace('entry.history.reset();', 'entry.history.reset(); printf("ALLOC %d\\n", replace_idx);')
+open("my_cond_branch_predictor.h", "w").write(code)
+
+os.system("make clean && make -s")
+res = subprocess.run(["./cbp", "sample_traces/int/sample_int_trace.gz"], capture_output=True, text=True, env={"SR_WORMHOLE_ENABLE": "1"})
