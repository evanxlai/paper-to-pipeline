diff --git a/sr_params.h b/sr_params.h
new file mode 100644
index 0000000..a22fa37
--- /dev/null
+++ b/sr_params.h
@@ -0,0 +1,53 @@
+// generated from the feature spec and the port plan; DSE mutates values only
+#pragma once
+#define SR_NUM_ENTRIES 5  // range: [1, 128]
+#define SR_TAG_BITS 18  // range: [8, 32]
+#define SR_CONF_BITS 4  // range: [1, 8]
+#define SR_RANK_BITS 3  // range: [1, 8]
+#define SR_HISTORY_BITS 101  // range: [16, 512]
+#define SR_LENGTH_BITS 7  // range: [4, 16]
+#define SR_NUM_COUNTERS 16  // range: [2, 256] pow2
+#define SR_COUNTER_BITS 5  // range: [2, 8]
+#define SR_THRESHOLD 16  // range: [0, 31]
+#define SR_MAX_IN_FLIGHT_BRANCHES 128  // range: [32, 512]
+// host knobs: the host's own structures, at the clean tree's values by default
+#define HOST_LOGG 10  // range: [8, 12]; sets LOGG
+#define HOST_TBITS 8  // range: [6, 12]; sets TBITS
+#define HOST_NBANKLOW 10  // range: [8, 12]; sets NBANKLOW
+#define HOST_NBANKHIGH 20  // range: [16, 24]; sets NBANKHIGH
+#define HOST_CWIDTH 3  // range: [2, 4]; sets CWIDTH
+#define HOST_UWIDTH 1  // range: [1, 2]; sets UWIDTH
+#define HOST_LOGB 13  // range: [10, 15]; sets LOGB
+#define HOST_HYSTSHIFT 2  // range: [1, 3]; sets HYSTSHIFT
+#define HOST_PERCWIDTH 6  // range: [4, 8]; sets PERCWIDTH
+#define HOST_LOGBIAS 8  // range: [6, 10]; sets LOGBIAS
+#define HOST_LOGGNB 10  // range: [8, 12]; sets LOGGNB
+#define HOST_LOGPNB 9  // range: [7, 11]; sets LOGPNB
+#define HOST_LOGLNB 10  // range: [8, 12]; sets LOGLNB
+#define HOST_LOGSNB 9  // range: [7, 11]; sets LOGSNB
+#define HOST_LOGTNB 10  // range: [8, 12]; sets LOGTNB
+#define HOST_LOGINB 8  // range: [6, 10]; sets LOGINB
+#define HOST_LOGIMNB 9  // range: [7, 11]; sets LOGIMNB
+#define HOST_LOGL 5  // range: [3, 7]; sets LOGL
+#define HOST_EWIDTH 6  // range: [4, 8]; sets EWIDTH
+// storage_bits is the sum of these, in bits:
+//   WPT: SR_NUM_ENTRIES * (SR_TAG_BITS + SR_CONF_BITS + SR_RANK_BITS + SR_LENGTH_BITS + SR_HISTORY_BITS + SR_NUM_COUNTERS * SR_COUNTER_BITS)
+//   WPT_InFlight_Meta: SR_MAX_IN_FLIGHT_BRANCHES * (1 + ceil(log2(SR_NUM_ENTRIES)) + SR_HISTORY_BITS + 2)
+//   host tagged tables, high banks: HOST_NBANKHIGH * 2 ** HOST_LOGG * (HOST_CWIDTH + HOST_UWIDTH + HOST_TBITS + 4)
+//   host tagged tables, low banks: HOST_NBANKLOW * 2 ** HOST_LOGG * (HOST_CWIDTH + HOST_UWIDTH + HOST_TBITS)
+//   host use-alt-on-NA counters: 16 * 5
+//   host bimodal, with shared hysteresis: 2 ** HOST_LOGB + 2 ** (HOST_LOGB - HOST_HYSTSHIFT)
+//   host global history, m[NHIST]: 3000
+//   host path history: 27
+//   host TICK counter: 10
+//   host loop predictor: 2 ** HOST_LOGL * (2 * 10 + 10 + 4 + 4 + 1)
+//   host loop predictor, counted again inside SC: 2 ** HOST_LOGL * (2 * 10 + 10 + 4 + 4 + 1)
+//   host SC thresholds and component weights: 12 + 8 * 2 ** 6 + 3 * HOST_EWIDTH * 2 ** 3
+//   host SC bias tables: HOST_PERCWIDTH * 3 * 2 ** HOST_LOGBIAS
+//   host SC global GEHL: (3 - 2) * 2 ** HOST_LOGGNB * HOST_PERCWIDTH + 2 ** (HOST_LOGGNB - 1) * 2 * HOST_PERCWIDTH + 40
+//   host SC path GEHL: (3 - 2) * 2 ** HOST_LOGPNB * HOST_PERCWIDTH + 2 ** (HOST_LOGPNB - 1) * 2 * HOST_PERCWIDTH
+//   host SC first local: (3 - 2) * 2 ** HOST_LOGLNB * HOST_PERCWIDTH + 2 ** (HOST_LOGLNB - 1) * 2 * HOST_PERCWIDTH + 256 * 11 + HOST_EWIDTH * 2 ** 3
+//   host SC second local: (3 - 2) * 2 ** HOST_LOGSNB * HOST_PERCWIDTH + 2 ** (HOST_LOGSNB - 1) * 2 * HOST_PERCWIDTH + 16 * 16 + HOST_EWIDTH * 2 ** 3
+//   host SC third local: (2 - 2) * 2 ** HOST_LOGTNB * HOST_PERCWIDTH + 2 ** (HOST_LOGTNB - 1) * 2 * HOST_PERCWIDTH + 16 * 9 + HOST_EWIDTH * 2 ** 3
+//   host SC IMLI: 2 ** (HOST_LOGINB - 1) * HOST_PERCWIDTH + 8 + 2 * 2 ** (HOST_LOGIMNB - 1) * HOST_PERCWIDTH + 2 * HOST_EWIDTH * 2 ** 3 + 256 * 10
+//   host chooser counters: 14
