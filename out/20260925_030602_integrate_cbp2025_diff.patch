diff --git a/test_dynamic_length.py b/test_dynamic_length.py
new file mode 100644
index 0000000..048490e
--- /dev/null
+++ b/test_dynamic_length.py
@@ -0,0 +1,267 @@
+import os
+import subprocess
+
+code = """#ifndef _PREDICTOR_H_
+#define _PREDICTOR_H_
+
+#include <stdlib.h>
+#include "sr_params.h"
+#include <vector>
+#include <unordered_map>
+#include <cmath>
+#include <algorithm>
+#include <bitset>
+#include <cstdlib>
+
+struct SampleHist
+{
+      uint64_t ghist;
+      bool tage_pred;
+      SampleHist() { ghist = 0; }
+};
+
+struct WPT_Entry {
+    uint32_t tag = 0;
+    int32_t conf = 0;
+    int32_t ranking = 0;
+    int32_t length = 0;
+    std::bitset<512> history = 0;
+    std::vector<int32_t> counters;
+    WPT_Entry() : counters(SR_NUM_COUNTERS, 0) {}
+};
+
+struct WPT_InFlight_Meta_Entry {
+    bool valid = false;
+    int32_t entry_idx = -1;
+    std::bitset<512> old_history = 0;
+    bool tage_pred = false;
+    bool wpt_pred = false;
+    bool has_wpt_pred = false;
+    int32_t lptotal = 0;
+};
+
+class SampleCondPredictor
+{
+        SampleHist active_hist;
+        std::unordered_map<uint64_t, SampleHist> pred_time_histories;
+        
+        bool sr_enabled = false;
+        std::vector<WPT_Entry> wpt;
+        std::unordered_map<uint64_t, WPT_InFlight_Meta_Entry> wpt_inflight_meta;
+        std::unordered_map<uint64_t, int8_t> fallback_counters;
+
+        int32_t cached_lptotal = 0;
+
+    public:
+
+        SampleCondPredictor (void) {}
+
+        void setup()
+        {
+            const char* e = getenv("SR_WORMHOLE_ENABLE");
+            sr_enabled = (e != nullptr && e[0] == '1');
+            wpt.resize(SR_NUM_ENTRIES);
+            wpt_inflight_meta.reserve(SR_MAX_IN_FLIGHT_BRANCHES);
+        }
+
+        void terminate() {}
+
+        uint64_t get_unique_inst_id(uint64_t seq_no, uint8_t piece) const
+        {
+            return (seq_no << 4) | (piece & 0x000F);
+        }
+
+        bool predict (uint64_t seq_no, uint8_t piece, uint64_t PC, const bool tage_pred)
+        {
+            active_hist.tage_pred = tage_pred;
+            pred_time_histories.emplace(get_unique_inst_id(seq_no, piece), active_hist);
+            const bool pred_taken = predict_using_given_hist(seq_no, piece, PC, active_hist, true);
+
+            if (!sr_enabled) {
+                return tage_pred;
+            }
+
+            int32_t lptotal = 0;
+            if (cbp2016_tage_sc_l.LHIT != -1) {
+                lptotal = cbp2016_tage_sc_l.active_hist.ltable[cbp2016_tage_sc_l.LHIT].NbIter;
+                cached_lptotal = lptotal;
+            } else {
+                lptotal = cached_lptotal;
+            }
+            if (cbp2016_tage_sc_l.active_hist.IMLIcount == 0) cached_lptotal = 0;
+
+            int32_t entry_idx = -1;
+            uint32_t tag_val = PC & ((1ULL << SR_TAG_BITS) - 1);
+            for (int i = 0; i < SR_NUM_ENTRIES; i++) {
+                if (wpt[i].tag == tag_val) {
+                    entry_idx = i;
+                    break;
+                }
+            }
+
+            bool pred_valid = false;
+            bool final_pred = tage_pred;
+            bool internal_pred = false;
+
+            if (entry_idx != -1) {
+                auto& entry = wpt[entry_idx];
+                int h0 = entry.history[0];
+                int hl = entry.history[std::min((int)entry.length, SR_HISTORY_BITS - 1)];
+                int hl1 = entry.history[std::min(std::max((int)entry.length - 1, 0), SR_HISTORY_BITS - 1)];
+                int hl2 = entry.history[std::min(std::max((int)entry.length - 2, 0), SR_HISTORY_BITS - 1)];
+                int idx = (h0 << 3) | (hl << 2) | (hl1 << 1) | hl2;
+
+                int32_t sat_value = entry.counters[idx];
+                internal_pred = (sat_value >= 0);
+                
+                if (entry.conf > 0 && std::abs(2 * sat_value + 1) >= SR_THRESHOLD) {
+                    pred_valid = true;
+                    final_pred = internal_pred;
+                }
+            }
+
+            uint64_t inst_id = get_unique_inst_id(seq_no, piece);
+            WPT_InFlight_Meta_Entry meta;
+            meta.valid = true;
+            meta.entry_idx = entry_idx;
+            meta.lptotal = lptotal;
+
+            if (entry_idx != -1) {
+                meta.old_history = wpt[entry_idx].history;
+                meta.tage_pred = tage_pred;
+                meta.wpt_pred = internal_pred;
+                meta.has_wpt_pred = true;
+            }
+            wpt_inflight_meta[inst_id] = meta;
+
+            return pred_valid ? final_pred : tage_pred;
+        }
+
+        bool predict_using_given_hist (uint64_t seq_no, uint8_t piece, uint64_t PC, const SampleHist& hist_to_use, const bool pred_time_predict)
+        {
+            return hist_to_use.tage_pred;
+        }
+
+        void history_update (uint64_t seq_no, uint8_t piece, uint64_t PC, bool taken, uint64_t nextPC)
+        {
+            if (sr_enabled) {
+                uint64_t inst_id = get_unique_inst_id(seq_no, piece);
+                if (wpt_inflight_meta.count(inst_id)) {
+                    auto& meta = wpt_inflight_meta[inst_id];
+                    if (meta.entry_idx != -1) {
+                        wpt[meta.entry_idx].history <<= 1;
+                        wpt[meta.entry_idx].history.set(0, taken);
+                    }
+                }
+            }
+        }
+
+        void update (uint64_t seq_no, uint8_t piece, uint64_t PC, bool resolveDir, bool predDir, uint64_t nextPC)
+        {
+            const auto pred_hist_key = get_unique_inst_id(seq_no, piece);
+            const auto& pred_time_history = pred_time_histories.at(pred_hist_key);
+            
+            if (sr_enabled) {
+                auto it = wpt_inflight_meta.find(pred_hist_key);
+                if (it != wpt_inflight_meta.end()) {
+                    auto& meta = it->second;
+                    
+                    if (fallback_counters.find(PC) == fallback_counters.end()) {
+                        fallback_counters[PC] = 0;
+                    }
+                    if (meta.tage_pred != resolveDir) {
+                        fallback_counters[PC] = std::min((int)fallback_counters[PC] + 1, 3);
+                    } else {
+                        fallback_counters[PC] = 0; // consecutive mispredictions
+                    }
+
+                    bool problematic = (fallback_counters[PC] >= 2);
+                    if (problematic && meta.lptotal > 0) {
+                        int32_t entry_idx = -1;
+                        uint32_t tag_val = PC & ((1ULL << SR_TAG_BITS) - 1);
+                        for (int i = 0; i < SR_NUM_ENTRIES; i++) {
+                            if (wpt[i].tag == tag_val) {
+                                entry_idx = i;
+                                break;
+                            }
+                        }
+
+                        if (entry_idx != -1) {
+                            wpt[entry_idx].ranking = std::min(wpt[entry_idx].ranking + 1, (1 << SR_RANK_BITS) - 1);
+                        } else {
+                            int32_t min_rank = (1 << SR_RANK_BITS);
+                            int32_t replace_idx = 0;
+                            for (int i = 0; i < SR_NUM_ENTRIES; i++) {
+                                if (wpt[i].ranking < min_rank) {
+                                    min_rank = wpt[i].ranking;
+                                    replace_idx = i;
+                                }
+                            }
+                            
+                            auto& entry = wpt[replace_idx];
+                            entry.tag = tag_val;
+                            entry.conf = 0;
+                            entry.ranking = 0;
+                            entry.length = meta.lptotal & ((1ULL << SR_LENGTH_BITS) - 1);
+                            entry.history.reset();
+                            std::fill(entry.counters.begin(), entry.counters.end(), 0);
+                        }
+                    }
+
+                    if (meta.valid && meta.entry_idx != -1) {
+                        auto& entry = wpt[meta.entry_idx];
+                        
+                        // FIX: Dynamically update entry.length if we finally have a valid lptotal
+                        if (meta.lptotal > 0) {
+                            entry.length = meta.lptotal & ((1ULL << SR_LENGTH_BITS) - 1);
+                        }
+
+                        if (meta.has_wpt_pred && meta.wpt_pred != meta.tage_pred) {
+                            if (meta.wpt_pred == resolveDir) {
+                                entry.conf = std::min(entry.conf + 1, (1 << SR_CONF_BITS) - 1);
+                            } else {
+                                entry.conf = std::max(entry.conf - 1, 0);
+                            }
+                        }
+
+                        auto& old_hist = meta.old_history;
+                        int h0 = old_hist[0];
+                        int hl = old_hist[std::min((int)entry.length, SR_HISTORY_BITS - 1)];
+                        int hl1 = old_hist[std::min(std::max((int)entry.length - 1, 0), SR_HISTORY_BITS - 1)];
+                        int hl2 = old_hist[std::min(std::max((int)entry.length - 2, 0), SR_HISTORY_BITS - 1)];
+                        int idx = (h0 << 3) | (hl << 2) | (hl1 << 1) | hl2;
+
+                        int32_t sat_value = entry.counters[idx];
+                        if (resolveDir) {
+                            entry.counters[idx] = std::min(sat_value + 1, (1 << (SR_COUNTER_BITS - 1)) - 1);
+                        } else {
+                            entry.counters[idx] = std::max(sat_value - 1, -(1 << (SR_COUNTER_BITS - 1)));
+                        }
+                        
+                        meta.valid = false;
+                    }
+                    wpt_inflight_meta.erase(it);
+                }
+            }
+            
