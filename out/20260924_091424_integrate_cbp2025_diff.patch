+        bool decay_started = (sR_RegTable[5].decay_ctr == ((1 << SR_DECAY_CTR_BITS) - 1));
+        
+        for (int i = 0; i < ((1 << SR_DECAY_CTR_BITS) - 1); i++) {
+            allocate_register(999, false, 0);
+        }
+        bool reaches_zero = (sR_RegTable[5].decay_ctr == 0);
+        allocate_register(999, false, 0);
+        bool cleared = (sR_RegTable[5].valid == 0);
+        
+        if (decay_started && reaches_zero && cleared) {
+            std::cout << "PASS: decay_counter_walks_down\n";
+        }
+    }
+
+    // ut_int_digest
+    {
+        sR_RegTable[5].valid = 0;
+        sR_RegTable[5].payload = 200;
+        sR_RegTable[5].decay_ctr = 0;
+        write_register_digest(200, true, 5, 0xFFFFFFFFFFFFFFF0ULL, true, false, false);
+        if (sR_RegTable[5].valid == 1 && sR_RegTable[5].payload == 0xC04) {
+            std::cout << "PASS: int_digest_generation\n";
+        }
+    }
+
+    // ut_predict_useful
+    {
+        memset(sR_RegTable, 0, sizeof(sR_RegTable));
+        memset(sR_UT0, 0, sizeof(sR_UT0));
+        memset(sR_UT1, 0, sizeof(sR_UT1));
+        memset(sR_UT2, 0, sizeof(sR_UT2));
+        memset(sR_WT0, 0, sizeof(sR_WT0));
+        memset(sR_WT1, 0, sizeof(sR_WT1));
+        memset(sR_WT2, 0, sizeof(sR_WT2));
+
+        sR_RegTable[0].valid = 1;
+        sR_RegTable[0].payload = 0xAAA;
+        sR_RegTable[8].valid = 1;
+        sR_RegTable[8].payload = 0xBBB;
+
+        uint64_t PC = 0x1000;
+        uint32_t u_idx0 = hash_ut(PC, 0) % SR_UT0_ENTRIES;
+
+        sR_UT0[0][u_idx0][8] = 10;
+        sR_UT0[0][u_idx0][0] = -10;
+
+        uint32_t w_idx0_8 = hash_wt(PC, 0xBBB, 0) % SR_WT0_ENTRIES;
+        sR_WT0[0][w_idx0_8] = 50;
+
+        int32_t pred = sr_predict(PC, 999, true);
+        if (pred == (int32_t)(50 * SR_USEFUL_MULTIPLIER)) {
+            std::cout << "PASS: predict_selects_most_useful\n";
+        }
+    }
+
+    // ut_update_random
+    {
+        memset(sR_WT0, 0, sizeof(sR_WT0));
+        memset(sR_UT0, 0, sizeof(sR_UT0));
+        uint64_t PC = 0x2000;
+        uint64_t rob = 555;
+        sR_InFlightState[rob].valid_regs[0] = 1;
+        sR_InFlightState[rob].valid_regs[8] = 1;
+        sR_RegTable[0].payload = 0x111;
+        sR_RegTable[8].payload = 0x222;
+        
+        sr_update(PC, rob, true, true);
+        
+        uint32_t u_idx0 = hash_ut(PC, 0) % SR_UT0_ENTRIES;
+        int changed = 0;
+        if (sR_UT0[0][u_idx0][0] != 0) changed++;
+        if (sR_UT0[0][u_idx0][8] != 0) changed++;
+        if (changed == 1) {
+            std::cout << "PASS: update_random_selection\n";
+        }
+    }
+
+    // ut_recovery
+    {
+        memset(sR_RegTable, 0, sizeof(sR_RegTable));
+        sR_RegTable[5].valid = 0;
+        sR_RegTable[5].payload = 900 & ((1ULL << SR_ROB_IDX_BITS) - 1);
+        recovery(900);
+        if (sR_RegTable[5].valid == 0 && sR_RegTable[5].payload == 0) {
+            std::cout << "PASS: recovery_clears_pending\n";
+        }
+    }
+}
