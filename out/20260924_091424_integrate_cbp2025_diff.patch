diff --git a/patch_my_cond_branch_predictor_h2.py b/patch_my_cond_branch_predictor_h2.py
new file mode 100644
index 0000000..6797d20
--- /dev/null
+++ b/patch_my_cond_branch_predictor_h2.py
@@ -0,0 +1,61 @@
+import re
+
+with open("my_cond_branch_predictor.h", "r") as f:
+    content = f.read()
+
+impl = """
+        uint64_t extract_fp_sign_and_exp(uint64_t val) {
+            return (val >> 55) & 0x1FF;
+        }
+
+        void allocate_register(uint64_t rob_index, bool has_dest, uint64_t dest_reg) {
+            if (!sr_enabled) return;
+            for (int r = 0; r < SR_NUM_LOGICAL_REGS; r++) {
+                if (sR_RegTable[r].decay_ctr > 0) {
+                    sR_RegTable[r].decay_ctr--;
+                } else if (sR_RegTable[r].decay_ctr == 0) {
+                    sR_RegTable[r].valid = 0;
+                }
+            }
+            if (has_dest && dest_reg < SR_NUM_LOGICAL_REGS) {
+                sR_RegTable[dest_reg].valid = 0;
+                sR_RegTable[dest_reg].payload = rob_index & ((1ULL << SR_ROB_IDX_BITS) - 1);
+            }
+        }
+
+        void write_register_digest(uint64_t rob_index, bool has_dest, uint64_t dest_reg, uint64_t result_value, bool is_int, bool is_fp, bool is_flag) {
+            if (!sr_enabled) return;
+            if (has_dest && dest_reg < SR_NUM_LOGICAL_REGS) {
+                uint64_t masked_rob = rob_index & ((1ULL << SR_ROB_IDX_BITS) - 1);
+                if (sR_RegTable[dest_reg].valid == 0 && sR_RegTable[dest_reg].payload == masked_rob) {
+                    uint64_t val = result_value;
+                    uint64_t digest = 0;
+                    if (is_int) {
+                        int trailing = val == 0 ? 64 : __builtin_ctzll(val);
+                        int leading = val == 0 ? 64 : __builtin_clzll(val);
+                        trailing = trailing > 63 ? 63 : trailing;
+                        leading = leading > 63 ? 63 : leading;
+                        uint64_t val6 = val & 0x3F;
+                        digest = (trailing & 0x3F) ^ ((leading & 0x3F) << 3) ^ (val6 << 6);
+                    } else if (is_fp) {
+                        digest = extract_fp_sign_and_exp(val) << 3;
+                    } else if (is_flag) {
+                        uint64_t val4 = val & 0xF;
+                        digest = val4 | (val4 << 4) | (val4 << 8);
+                    } else {
+                        digest = 0;
+                    }
+                    
+                    sR_RegTable[dest_reg].payload = digest & 0xFFF;
+                    sR_RegTable[dest_reg].valid = 1;
+                    sR_RegTable[dest_reg].decay_ctr = (1 << SR_DECAY_CTR_BITS) - 1;
+                }
+            }
+        }
+"""
+
+content = re.sub(r'void allocate_register\(.*?\)\s*\{\s*if\s*\(!sr_enabled\)\s*return;\s*\}', '', content, flags=re.DOTALL)
+content = re.sub(r'void write_register_digest\(.*?\)\s*\{\s*if\s*\(!sr_enabled\)\s*return;\s*\}', impl.strip(), content, flags=re.DOTALL)
+
+with open("my_cond_branch_predictor.h", "w") as f:
+    f.write(content)
