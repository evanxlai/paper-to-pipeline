diff --git a/debug_digest.cc b/debug_digest.cc
new file mode 100644
index 0000000..fe0ed6d
--- /dev/null
+++ b/debug_digest.cc
@@ -0,0 +1,14 @@
+#include <iostream>
+#include <cstdint>
+
+int main() {
+    uint64_t val = 0xFFFFFFFFFFFFFFF0ULL;
+    int trailing = val == 0 ? 64 : __builtin_ctzll(val);
+    int leading = val == 0 ? 64 : __builtin_clzll(val);
+    trailing = trailing > 63 ? 63 : trailing;
+    leading = leading > 63 ? 63 : leading;
+    uint64_t val6 = val & 0x3F;
+    uint64_t digest = (trailing & 0x3F) ^ ((leading & 0x3F) << 3) ^ (val6 << 6);
+    std::cout << std::hex << digest << std::endl;
+    return 0;
+}
