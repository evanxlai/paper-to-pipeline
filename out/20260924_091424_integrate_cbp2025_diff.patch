+import re
+
+with open("my_cond_branch_predictor.h", "r") as f:
+    content = f.read()
+
+impl = """
+        uint32_t hash_ut(uint64_t PC, int table) {
+            return (PC ^ (PC >> (2 + table * 2)));
+        }
+        uint32_t hash_wt(uint64_t PC, uint32_t digest, int table) {
+            return (PC ^ (digest << (table + 1)));
+        }
+
+        int32_t sr_predict(uint64_t PC, uint64_t rob_index) {
+            if (!sr_enabled) return 0;
+            
+            uint64_t masked_rob = rob_index & ((1ULL << SR_ROB_IDX_BITS) - 1);
+            InFlightEntry& if_entry = sR_InFlightState[masked_rob];
+            for (int r = 0; r < SR_NUM_LOGICAL_REGS; r++) {
+                if_entry.valid_regs[r] = sR_RegTable[r].valid;
+            }
+
+            int32_t sR = 0;
+            for (int b = 0; b < SR_NUM_BANKS; b++) {
+                uint32_t u_idx0 = hash_ut(PC, 0) % SR_UT0_ENTRIES;
+                uint32_t u_idx1 = hash_ut(PC, 1) % SR_UT1_ENTRIES;
+                uint32_t u_idx2 = hash_ut(PC, 2) % SR_UT2_ENTRIES;
+                
+                int32_t max_u = -99999;
+                int best_reg = -1;
+                
+                for (int r = 0; r < SR_NUM_LOGICAL_REGS; r++) {
+                    if ((r % SR_NUM_BANKS) == b && sR_RegTable[r].valid == 1) {
+                        int32_t u_sum = sR_UT0[b][u_idx0][r] + sR_UT1[b][u_idx1][r] + sR_UT2[b][u_idx2][r];
+                        if (u_sum > max_u) {
+                            max_u = u_sum;
+                            best_reg = r;
+                        }
+                    }
+                }
+                
+                int32_t bank_sum = 0;
+                if (best_reg != -1) {
+                    uint32_t digest = sR_RegTable[best_reg].payload;
+                    uint32_t w_idx0 = hash_wt(PC, digest, 0) % SR_WT0_ENTRIES;
+                    uint32_t w_idx1 = hash_wt(PC, digest, 1) % SR_WT1_ENTRIES;
+                    uint32_t w_idx2 = hash_wt(PC, digest, 2) % SR_WT2_ENTRIES;
+                    bank_sum = sR_WT0[b][w_idx0] + sR_WT1[b][w_idx1] + sR_WT2[b][w_idx2];
+                }
+                
+                if (max_u > 0) {
+                    sR += (int32_t)(bank_sum * SR_USEFUL_MULTIPLIER);
+                }
+            }
+            return sR;
+        }
+
+        void sr_update(uint64_t PC, uint64_t rob_index, bool taken, bool match) {
+            if (!sr_enabled) return;
+            
+            uint64_t masked_rob = rob_index & ((1ULL << SR_ROB_IDX_BITS) - 1);
+            if (sR_InFlightState.find(masked_rob) == sR_InFlightState.end()) return;
+            InFlightEntry if_entry = sR_InFlightState[masked_rob];
+            sR_InFlightState.erase(masked_rob);
+            
+            for (int b = 0; b < SR_NUM_BANKS; b++) {
+                int num_available = 0;
+                for (int r = 0; r < SR_NUM_LOGICAL_REGS; r++) {
+                    if ((r % SR_NUM_BANKS) == b && if_entry.valid_regs[r] == 1) {
+                        num_available++;
+                    }
+                }
+                
+                if (num_available > 0) {
+                    // "random_int() % num_available"
+                    // we'll just use PC as a pseudo-random seed to keep it deterministic
+                    int chosen_idx = (PC + b) % num_available;
+                    int current_idx = 0;
+                    int chosen_reg = 0;
+                    for (int r = 0; r < SR_NUM_LOGICAL_REGS; r++) {
+                        if ((r % SR_NUM_BANKS) == b && if_entry.valid_regs[r] == 1) {
+                            if (current_idx == chosen_idx) {
+                                chosen_reg = r;
+                            }
+                            current_idx++;
+                        }
+                    }
+                    
+                    uint32_t u_idx0 = hash_ut(PC, 0) % SR_UT0_ENTRIES;
+                    uint32_t u_idx1 = hash_ut(PC, 1) % SR_UT1_ENTRIES;
+                    uint32_t u_idx2 = hash_ut(PC, 2) % SR_UT2_ENTRIES;
+                    
+                    int32_t u_delta = match ? 1 : -1; 
+                    
+                    sR_UT0[b][u_idx0][chosen_reg] = std::max(-128, std::min(127, sR_UT0[b][u_idx0][chosen_reg] + u_delta));
+                    sR_UT1[b][u_idx1][chosen_reg] = std::max(-128, std::min(127, sR_UT1[b][u_idx1][chosen_reg] + u_delta));
+                    sR_UT2[b][u_idx2][chosen_reg] = std::max(-128, std::min(127, sR_UT2[b][u_idx2][chosen_reg] + u_delta));
+                    
+                    uint32_t digest = sR_RegTable[chosen_reg].payload;
+                    uint32_t w_idx0 = hash_wt(PC, digest, 0) % SR_WT0_ENTRIES;
+                    uint32_t w_idx1 = hash_wt(PC, digest, 1) % SR_WT1_ENTRIES;
+                    uint32_t w_idx2 = hash_wt(PC, digest, 2) % SR_WT2_ENTRIES;
+                    
+                    int32_t w_delta = taken ? 1 : -1;
+                    sR_WT0[b][w_idx0] = std::max(-128, std::min(127, sR_WT0[b][w_idx0] + w_delta));
+                    sR_WT1[b][w_idx1] = std::max(-128, std::min(127, sR_WT1[b][w_idx1] + w_delta));
+                    sR_WT2[b][w_idx2] = std::max(-128, std::min(127, sR_WT2[b][w_idx2] + w_delta));
+                }
+            }
+        }
+"""
+
+content = re.sub(r'int32_t sr_predict\(.*?\)\s*\{\s*return 0;\s*\}', '', content, flags=re.DOTALL)
+content = re.sub(r'void sr_update\(.*?\)\s*\{\s*\}', impl.strip(), content, flags=re.DOTALL)
+
+with open("my_cond_branch_predictor.h", "w") as f:
+    f.write(content)
