+#include "my_cond_branch_predictor.h"
+#include <cmath>
+#include <iostream>
+
+SampleCondPredictor cond_predictor_impl;
+
+SampleCondPredictor::SampleCondPredictor()
+{
+    sr_enabled = false;
+    prng_state = 1;
+
+    for (int b = 0; b < SR_NUM_BANKS; ++b) {
+        sr_wt_0[b].resize(SR_WT0_ENTRIES, 0);
+        sr_wt_1[b].resize(SR_WT1_ENTRIES, 0);
+        sr_wt_2[b].resize(SR_WT2_ENTRIES, 0);
+    }
+    sr_ut_0.resize(SR_UT0_ENTRIES, std::vector<int8_t>(SR_NUM_LOGICAL_REGS, 0));
+    sr_ut_1.resize(SR_UT1_ENTRIES, std::vector<int8_t>(SR_NUM_LOGICAL_REGS, 0));
+    sr_ut_2.resize(SR_UT2_ENTRIES, std::vector<int8_t>(SR_NUM_LOGICAL_REGS, 0));
+
+    for (int i = 0; i < SR_NUM_LOGICAL_REGS; ++i) {
+        reg_status[i].valid = false;
+        reg_status[i].payload = 0;
+        reg_status[i].decay_ctr = 0;
+    }
+}
+
+void run_unit_tests();
+
+void SampleCondPredictor::setup()
+{
+    const char* env = getenv("SR_SR_ENABLE");
+    sr_enabled = (env != nullptr && env[0] == '1');
+    if (sr_enabled) {
+        run_unit_tests();
+    }
+}
+
+int count_leading_bits_equal_to_uint64(uint64_t v, int bit) {
+    if (bit == 0) {
+        if (v == 0) return 64;
+        return __builtin_clzll(v);
+    } else {
+        if (v == ~(uint64_t)0) return 64;
+        return __builtin_clzll(~v);
+    }
+}
+
+int count_trailing_bits_equal_to_uint64(uint64_t v, int bit) {
+    if (bit == 0) {
+        if (v == 0) return 64;
+        return __builtin_ctzll(v);
+    } else {
+        if (v == ~(uint64_t)0) return 64;
+        return __builtin_ctzll(~v);
+    }
+}
+
+uint64_t SampleCondPredictor::fold(uint64_t x, int n)
+{
+    uint64_t r = 0;
+    while (x != 0) {
+        r = r ^ (x & ((1ULL << n) - 1));
+        x = x >> n;
+    }
+    return r;
+}
+
+int8_t SampleCondPredictor::sat_update(int8_t c, bool up, int bits)
+{
+    int max_val = (1 << (bits - 1)) - 1;
+    int min_val = -(1 << (bits - 1));
+    if (up) {
+        if (c < max_val) {
+            c = c + 1;
+        }
+    } else {
+        if (c > min_val) {
+            c = c - 1;
+        }
+    }
+    return c;
+}
+
+uint64_t SampleCondPredictor::prng_next()
+{
+    uint64_t x = prng_state;
+    x = x ^ ((x << 13) & 0xFFFFFFFFFFFFFFFFULL);
+    x = x ^ (x >> 7);
+    x = x ^ ((x << 17) & 0xFFFFFFFFFFFFFFFFULL);
+    prng_state = x;
+    return x;
+}
+
+uint64_t SampleCondPredictor::wt_index(uint64_t pc, uint64_t d, int k, int n)
+{
+    uint64_t pcw = pc >> 2;
+    return fold(pcw ^ (pcw >> (n + k + 1)) ^ (d << (3 * k)), n);
+}
+
+uint64_t SampleCondPredictor::ut_index(uint64_t pc, int k, int m)
+{
+    uint64_t pcw = pc >> 2;
+    return fold(pcw ^ (pcw >> (m + k + 1)), m);
+}
+
+uint64_t SampleCondPredictor::generate_digest(uint64_t v, int r)
+{
+    uint64_t d = 0;
+    if (r < 32) {
+        int msb = (v >> 63) & 1;
+        int lsb = v & 1;
+        int lead = count_leading_bits_equal_to_uint64(v, msb);
+        int trail = count_trailing_bits_equal_to_uint64(v, lsb);
+        d = (trail & 0x3F) ^ ((lead & 0x3F) << 3) ^ ((v & 0x3F) << 6);
+    } else if (r < 64) {
+        if ((v >> 16) == 0) {
+            d = (v >> 13) & 0x7;
+        } else if ((v >> 32) == 0) {
+            d = (v >> 26) & 0x3F;
+        } else {
+            d = (v >> 55) & 0x1FF;
+        }
+    } else {
+        uint64_t f = v & 0xF;
+        d = f | (f << 4) | (f << 8);
+    }
+    return d & 0xFFF;
+}
+
+void SampleCondPredictor::notify_decode(uint64_t seq_no, uint8_t piece, uint64_t pc, const DecodeInfo& _decode_info)
+{
+    if (!sr_enabled) return;
+
+    for (int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+        if (reg_status[r].valid) {
+            if (reg_status[r].decay_ctr == 0) {
+                reg_status[r].valid = false;
+                reg_status[r].payload = 0;
+            } else {
+                reg_status[r].decay_ctr = reg_status[r].decay_ctr - 1;
+            }
+        }
+    }
+    
+    int dest = -1;
+    if (_decode_info.dst_reg_info.has_value()) {
+        dest = _decode_info.dst_reg_info.value();
+    }
+    
+    bool first_write_of_dest = true;
+    if (piece != 0) {
+        first_write_of_dest = false;
+    }
+    
+    if (dest >= 0 && dest < SR_NUM_LOGICAL_REGS && first_write_of_dest) {
+        reg_status[dest].valid = false;
+        reg_status[dest].payload = get_unique_inst_id(seq_no, piece) & ((1 << SR_TAG_BITS) - 1);
+        reg_status[dest].decay_ctr = 0;
+    }
+}
+
+void SampleCondPredictor::notify_execute(uint64_t seq_no, uint8_t piece, uint64_t pc, const ExecuteInfo& _exec_info)
+{
+    if (!sr_enabled) return;
+    
+    int dest = -1;
+    if (_exec_info.dec_info.dst_reg_info.has_value()) {
+        dest = _exec_info.dec_info.dst_reg_info.value();
+    }
+    
+    bool first_write_of_dest = true;
+    if (piece != 0) {
+        first_write_of_dest = false;
+    }
+    
+    if (dest < 0 || dest >= SR_NUM_LOGICAL_REGS || !first_write_of_dest) return;
+    if (!_exec_info.dst_reg_value.has_value()) return;
+    uint64_t v = _exec_info.dst_reg_value.value();
+    
+    uint64_t tag = get_unique_inst_id(seq_no, piece) & ((1 << SR_TAG_BITS) - 1);
+    
+    if (!reg_status[dest].valid && reg_status[dest].payload == tag) {
+        reg_status[dest].payload = generate_digest(v, dest);
+        reg_status[dest].valid = true;
+        reg_status[dest].decay_ctr = (1 << SR_DECAY_CTR_BITS) - 1;
+    }
+}
+
+int log2_constexpr(int n) {
+    int res = 0;
+    while (n > 1) {
+        res++;
+        n >>= 1;
+    }
+    return res;
+}
+
+int32_t SampleCondPredictor::sr_predict_internal(uint64_t seq_no, uint8_t piece, uint64_t pc)
+{
+    if (!sr_enabled) return 0;
+    uint64_t branch_id = get_unique_inst_id(seq_no, piece);
+    if (sr_checkpoint.find(branch_id) != sr_checkpoint.end()) {
+        int32_t sr_total_cp = 0;
+        for (int b = 0; b < SR_NUM_BANKS; ++b) {
+            sr_total_cp += sr_checkpoint[branch_id].bank[b].contrib;
+        }
+        return sr_total_cp;
+    }
+    int32_t sr_total = 0;
+    
+    SrCheckpoint cp;
+    for (int b = 0; b < SR_NUM_BANKS; ++b) {
+        cp.bank[b].contrib = 0;
+        cp.bank[b].train_valid = false;
+        
+        std::vector<int> avail;
+        for (int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+            if ((r % SR_NUM_BANKS) == b && reg_status[r].valid) {
+                avail.push_back(r);
+            }
+        }
+        
+        if (avail.empty()) continue;
+        
+        int i0 = ut_index(pc, 0, log2_constexpr(SR_UT0_ENTRIES));
+        int i1 = ut_index(pc, 1, log2_constexpr(SR_UT1_ENTRIES));
+        int i2 = ut_index(pc, 2, log2_constexpr(SR_UT2_ENTRIES));
+        
+        int best_reg = -1;
+        int best_u = 0;
+        for (int r : avail) {
+            int u = sr_ut_0[i0][r] + sr_ut_1[i1][r] + sr_ut_2[i2][r];
+            if (best_reg == -1 || u > best_u) {
+                best_reg = r;
+                best_u = u;
+            }
+        }
+        
+        uint64_t d = reg_status[best_reg].payload & 0xFFF;
+        int j0 = wt_index(pc, d, 0, log2_constexpr(SR_WT0_ENTRIES));
+        int j1 = wt_index(pc, d, 1, log2_constexpr(SR_WT1_ENTRIES));
+        int j2 = wt_index(pc, d, 2, log2_constexpr(SR_WT2_ENTRIES));
+        
+        int wsum = (2 * sr_wt_0[b][j0] + 1) +
+                   (2 * sr_wt_1[b][j1] + 1) +
+                   (2 * sr_wt_2[b][j2] + 1);
+                   
+        int16_t contrib = 0;
+        if (best_u >= SR_USEFUL_THRESHOLD) {
+            contrib = (int16_t)(wsum * SR_USEFUL_MULTIPLIER);
+        }
+        
+        cp.bank[b].contrib = contrib;
+        int t = avail[prng_next() % avail.size()];
+        cp.bank[b].train_valid = true;
+        cp.bank[b].train_reg = t;
+        cp.bank[b].train_digest = reg_status[t].payload & 0xFFF;
+        
+        sr_total += contrib;
+    }
+    
+    sr_checkpoint[branch_id] = cp;
+    return sr_total;
+}
+
+void SampleCondPredictor::sr_update_internal(uint64_t seq_no, uint8_t piece, uint64_t pc, bool resolveDir, int lsum)
+{
+    if (!sr_enabled) return;
+    
+    uint64_t branch_id = get_unique_inst_id(seq_no, piece);
+    if (sr_checkpoint.find(branch_id) == sr_checkpoint.end()) return;
+    
+    SrCheckpoint cp = sr_checkpoint[branch_id];
+    
+    for (int b = 0; b < SR_NUM_BANKS; ++b) {
+        if (!cp.bank[b].train_valid) continue;
+        
+        int t = cp.bank[b].train_reg;
+        uint64_t d = cp.bank[b].train_digest;
+        
+        int j0 = wt_index(pc, d, 0, log2_constexpr(SR_WT0_ENTRIES));
+        int j1 = wt_index(pc, d, 1, log2_constexpr(SR_WT1_ENTRIES));
+        int j2 = wt_index(pc, d, 2, log2_constexpr(SR_WT2_ENTRIES));
+        
+        int p_t = (2 * sr_wt_0[b][j0] + 1) +
+                  (2 * sr_wt_1[b][j1] + 1) +
+                  (2 * sr_wt_2[b][j2] + 1);
+                  
+        int i0 = ut_index(pc, 0, log2_constexpr(SR_UT0_ENTRIES));
+        int i1 = ut_index(pc, 1, log2_constexpr(SR_UT1_ENTRIES));
+        int i2 = ut_index(pc, 2, log2_constexpr(SR_UT2_ENTRIES));
+        
+        bool agrees = (p_t >= 0) == resolveDir;
+        bool move = false;
+        
+        if (SR_UT_UPDATE_RULE == 0) { // sign_flip
+            int xsum = lsum - cp.bank[b].contrib;
+            int with_t = xsum + (int)(p_t * SR_USEFUL_MULTIPLIER);
+            move = (with_t >= 0) != (xsum >= 0);
+        } else { // agreement
+            move = true;
+        }
+        
+        if (move) {
+            sr_ut_0[i0][t] = sat_update(sr_ut_0[i0][t], agrees, SR_UT_BITS);
+            sr_ut_1[i1][t] = sat_update(sr_ut_1[i1][t], agrees, SR_UT_BITS);
+            sr_ut_2[i2][t] = sat_update(sr_ut_2[i2][t], agrees, SR_UT_BITS);
+        }
+        
+        sr_wt_0[b][j0] = sat_update(sr_wt_0[b][j0], resolveDir, SR_WT_BITS);
+        sr_wt_1[b][j1] = sat_update(sr_wt_1[b][j1], resolveDir, SR_WT_BITS);
+        sr_wt_2[b][j2] = sat_update(sr_wt_2[b][j2], resolveDir, SR_WT_BITS);
+    }
+    
+    sr_checkpoint.erase(branch_id);
+}
+
+extern "C" int32_t sr_predict(uint64_t seq_no, uint8_t piece, uint64_t pc)
+{
+    return cond_predictor_impl.sr_predict_internal(seq_no, piece, pc);
+}
+
+extern "C" void sr_update(uint64_t seq_no, uint8_t piece, uint64_t pc, bool resolveDir, int lsum)
+{
+    cond_predictor_impl.sr_update_internal(seq_no, piece, pc, resolveDir, lsum);
+}
