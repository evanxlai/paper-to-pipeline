      },
      {
        "structure": "path history",
        "formula": "27"
      },
      {
        "structure": "TICK counter",
        "formula": "10"
      },
      {
        "structure": "loop predictor",
        "formula": "2**logl * 39"
      },
      {
        "structure": "loop predictor, counted again inside SC",
        "formula": "2**logl * 39"
      },
      {
        "structure": "SC thresholds and component weights",
        "formula": "524 + 24 * ewidth"
      },
      {
        "structure": "SC bias tables",
        "formula": "percwidth * 3 * 2**logbias"
      },
      {
        "structure": "SC global GEHL",
        "formula": "1 * 2**loggnb * percwidth + 2**(loggnb - 1) * 2 * percwidth + 40"
      },
      {
        "structure": "SC path GEHL",
        "formula": "1 * 2**logpnb * percwidth + 2**(logpnb - 1) * 2 * percwidth"
      },
      {
        "structure": "SC first local",
        "formula": "1 * 2**loglnb * percwidth + 2**(loglnb - 1) * 2 * percwidth + 2816 + 8 * ewidth"
      },
