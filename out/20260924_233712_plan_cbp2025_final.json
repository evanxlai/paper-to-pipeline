  "interface_resolutions": [
    {
      "spec_pointer": "/host_interfaces/0",
      "need": "destination logical register and ROB index at decode",
      "status": "exact",
      "resolution": "`notify_instr_decode` provides `dst_reg_info` in `DecodeInfo`. Uses `get_unique_inst_id(seq_no, piece)` as the ROB index.",
      "rationale": "Host exposes logical destinations at decode. ROB doesn't exist, but instruction ID serves the purpose."
    },
    {
      "spec_pointer": "/host_interfaces/1",
      "need": "completed instruction values",
      "status": "exact",
      "resolution": "`notify_instr_execute_resolve` provides `dst_reg_value` containing the real 64-bit result from the trace.",
      "rationale": "Host populates this from the trace. FP types are not distinguished by the trace, so format is deduced from register index (0-31 INT, 32-63 FP)."
    },
    {
      "spec_pointer": "/host_interfaces/2",
      "need": "decode rate / count",
      "status": "exact",
      "resolution": "`notify_instr_decode` fires once per instruction.",
      "rationale": "Host calls this hook at decode cycle."
    },
    {
      "spec_pointer": "/host_interfaces/3",
      "need": "branch squash signal",
      "status": "unavailable",
      "resolution": "No action is taken on a squash because the trace provides only committed instructions.",
      "rationale": "The simulator is trace-driven and does not model wrong-path execution.",
      "fidelity_note": "Because squashes do not occur, the Tomasulo table state is never polluted by wrong-path instructions. Recovery is unnecessary here, but real hardware would require it to prevent performance degradation."
    }
  ],
