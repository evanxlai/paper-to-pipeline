# Python
__pycache__/
*.pyc
.venv/
venv/

# Simulator checkouts and build output (vendored separately, never committed)
hosts/champsim/ChampSim/
hosts/gem5/gem5/
chia_nodes/cbp2025/cbp2025-sim/
build/
*.o
*.d

# Fetched paper inputs: the RUNLTS PDF, its extracted text and the reference
# artifact. Third-party content, ~8MB, and fully reproducible from
# scripts/fetch_artifacts.sh -- so it is fetched, not committed. Note that
# loop/constants.py defaults P2P_PAPER_TEXT here, so a fresh clone must run
# that script before --stage distill will find anything.
third_party/

# Traces and results (large; live in GCS)
traces/
results/
*.gz
*.xz

# Loop run artifacts: per-run dumps, specs and DSE evaluator logs written by
# helpers.Dumper and C.OUT_DIR. Regenerated by every run.
out/

# Node tooling deps (package.json / package-lock.json are tracked; these are not)
node_modules/

# Scratch files that have accumulated at the repo root
tmp.txt
.tmp.txt

# Secrets and local machine state
*.pem
*.key
id_ed25519*
.env
cluster/*.local.yaml

# Editor and OS noise
.DS_Store
.idea/
.vscode/
