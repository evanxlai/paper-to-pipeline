+        }
+        
+        int count_leading_zeros_or_ones(uint64_t val) {
+            if (val == 0) return 64;
+            if (val == ~(uint64_t)0) return 64;
+            uint64_t msb = val >> 63;
+            int count = 0;
+            while ((val >> 63) == msb && count < 64) {
+                count++;
+                val <<= 1;
+            }
+            return count;
+        }
+        
+        uint16_t generate_digest(uint64_t val, int reg) {
+            if (reg < 32) {
+                // INT
+                int trailing = std::min(count_trailing_zeros_or_ones(val), 63);
+                int leading = std::min(count_leading_zeros_or_ones(val), 63);
+                uint64_t lsb6 = val & 0x3F;
+                uint16_t digest = (trailing & 0x3F) ^ ((leading & 0x3F) << 3) ^ ((lsb6 & 0x3F) << 6);
+                return digest & 0xFFF;
+            } else if (reg < 64) {
+                // FP/SIMD (treated as FP64 as per "A port therefore picks one FP digest rule and records that deviation")
+                return ((val >> 55) & 0x1FF) << 3;
+            } else {
+                // FLAG
+                uint16_t flag4 = val & 0xF;
+                return flag4 | (flag4 << 4) | (flag4 << 8);
+            }
+        }
+        
+        void notify_decode(int dst_reg, uint16_t rob_tag) {
+            if (!sr_enabled) return;
+            
+            if (dst_reg >= 0 && dst_reg < SR_NUM_LOGICAL_REGS) {
+                reg_status_table[dst_reg].valid = false;
+                reg_status_table[dst_reg].payload = rob_tag & 0x3FFF;
+                reg_status_table[dst_reg].decay_ctr = 0;
+            }
+            
+            for (int r = 0; r < SR_NUM_LOGICAL_REGS; r++) {
+                if (reg_status_table[r].valid) {
+                    if (reg_status_table[r].decay_ctr < SR_DECAY_THRESHOLD_INSTS) {
+                        reg_status_table[r].decay_ctr++;
+                    }
+                    if (reg_status_table[r].decay_ctr >= SR_DECAY_THRESHOLD_INSTS) {
+                        reg_status_table[r].valid = false;
+                    }
+                }
+            }
+        }
+        
+        void notify_execute(int dst_reg, uint16_t rob_tag, uint64_t result_val) {
+            if (!sr_enabled) return;
+            
+            if (dst_reg >= 0 && dst_reg < SR_NUM_LOGICAL_REGS) {
+                if (!reg_status_table[dst_reg].valid && reg_status_table[dst_reg].payload == (rob_tag & 0x3FFF)) {
+                    reg_status_table[dst_reg].payload = generate_digest(result_val, dst_reg);
+                    reg_status_table[dst_reg].valid = true;
+                    reg_status_table[dst_reg].decay_ctr = 0;
+                }
+            }
+        }
+        
+        // Hashes
+        int hash_ut(uint64_t pc, int bank, int table) {
+            // Simple XOR folding
+            return (pc ^ (pc >> 3) ^ bank ^ table) % 8;
+        }
+        
+        int hash_wt0(uint64_t pc, uint16_t digest) {
+            return (pc ^ digest) % 512;
+        }
+        int hash_wt1(uint64_t pc, uint16_t digest) {
+            return (pc ^ (digest << 1)) % 256;
+        }
+        int hash_wt2(uint64_t pc, uint16_t digest) {
+            return (pc ^ (digest << 2)) % 128;
+        }
+        
+        int saturate_6bit(int val) {
+            if (val > 31) return 31;
+            if (val < -32) return -32;
+            return val;
+        }
+
+        int predict_sr(uint64_t seq_no, uint8_t piece, uint64_t PC) {
+            int sR_sum = 0;
+            
+            SrPredHist hist;
+            
+            for (int bank = 0; bank < SR_NUM_BANKS; bank++) {
+                int best_reg = -1;
+                int best_usefulness = -999999;
+                bool has_valid = false;
+                
+                int idx0 = hash_ut(PC, bank, 0);
+                int idx1 = hash_ut(PC, bank, 1);
+                int idx2 = hash_ut(PC, bank, 2);
+                
+                for (int r = bank; r < SR_NUM_LOGICAL_REGS; r += 8) {
+                    if (reg_status_table[r].valid) {
+                        has_valid = true;
+                        int u = UT0[bank][idx0][r] + UT1[bank][idx1][r] + UT2[bank][idx2][r];
+                        if (u > best_usefulness) {
+                            best_usefulness = u;
+                            best_reg = r;
+                        }
+                    }
+                }
+                
+                if (!has_valid) continue;
+                
+                hist.valid_in_bank[bank] = true;
+                hist.best_reg_in_bank[bank] = best_reg;
+                uint16_t digest = reg_status_table[best_reg].payload & 0xFFF;
+                hist.digest_in_bank[bank] = digest;
+                
+                if (best_usefulness > 0) {
+                    int h0 = hash_wt0(PC, digest);
+                    int h1 = hash_wt1(PC, digest);
+                    int h2 = hash_wt2(PC, digest);
+                    int raw_wt_sum = WT0[bank][h0] + WT1[bank][h1] + WT2[bank][h2];
+                    int bank_contrib = (raw_wt_sum * 5) / 2;
+                    sR_sum += bank_contrib;
+                }
+            }
+            
+            sr_pred_histories.emplace(get_unique_inst_id(seq_no, piece), hist);
+            return sR_sum;
+        }
+        
+        void update_sr(uint64_t seq_no, uint8_t piece, uint64_t branch_pc, bool actual_taken) {
+            auto it = sr_pred_histories.find(get_unique_inst_id(seq_no, piece));
+            if (it == sr_pred_histories.end()) return;
+            const SrPredHist& hist = it->second;
+            
+            for (int bank = 0; bank < SR_NUM_BANKS; bank++) {
+                if (!hist.valid_in_bank[bank]) continue;
+                
+                int r_train = hist.best_reg_in_bank[bank];
+                uint16_t digest = hist.digest_in_bank[bank];
+                
+                int h0 = hash_wt0(branch_pc, digest);
+                int h1 = hash_wt1(branch_pc, digest);
+                int h2 = hash_wt2(branch_pc, digest);
+                
+                int delta = actual_taken ? 1 : -1;
+                WT0[bank][h0] = saturate_6bit(WT0[bank][h0] + delta);
+                WT1[bank][h1] = saturate_6bit(WT1[bank][h1] + delta);
+                WT2[bank][h2] = saturate_6bit(WT2[bank][h2] + delta);
+                
+                int idx0 = hash_ut(branch_pc, bank, 0);
+                int idx1 = hash_ut(branch_pc, bank, 1);
+                int idx2 = hash_ut(branch_pc, bank, 2);
+                
+                bool pred_agrees = ((WT0[bank][h0] + WT1[bank][h1] + WT2[bank][h2]) >= 0) == actual_taken;
+                int u_delta = pred_agrees ? 1 : -1;
+                UT0[bank][idx0][r_train] = saturate_6bit(UT0[bank][idx0][r_train] + u_delta);
+                UT1[bank][idx1][r_train] = saturate_6bit(UT1[bank][idx1][r_train] + u_delta);
+                UT2[bank][idx2][r_train] = saturate_6bit(UT2[bank][idx2][r_train] + u_delta);
+            }
+        }
 };
