+                    int u = UT0[b][idx0][r] + UT1[b][idx1][r] + UT2[b][idx2][r];"""
+new_loop = """                if (r % 8 == b && reg_status_table[r].valid) {
+                    st.valid_at_pred[b][r] = true;
+                    st.all_digests[b][r] = reg_status_table[r].payload & 0xFFF;
