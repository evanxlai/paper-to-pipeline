@@ -0,0 +1,61 @@
+import sys
+content = open('my_cond_branch_predictor.h').read()
+
+old_update = """    void update(uint64_t seq_no, uint8_t piece, uint64_t PC, bool resolveDir, bool predDir, uint64_t nextPC) {
+        const auto pred_hist_key = get_unique_inst_id(seq_no, piece);
+        const auto& pred_time_history = pred_time_histories.at(pred_hist_key);
+        update(PC, resolveDir, predDir, nextPC, pred_time_history);
+        pred_time_histories.erase(pred_hist_key);
+    }"""
+
+new_update = """    void update(uint64_t seq_no, uint8_t piece, uint64_t PC, bool resolveDir, bool predDir, uint64_t nextPC) {
+        const auto pred_hist_key = get_unique_inst_id(seq_no, piece);
+        const auto& pred_time_history = pred_time_histories.at(pred_hist_key);
+        
+        if (sr_enabled) {
+            auto it = sR_pred_state.find(pred_hist_key);
+            if (it != sR_pred_state.end()) {
+                PredState st = it->second;
+                // Update on mispredict
+                if (predDir != resolveDir) {
+                    for(int b=0; b<SR_NUM_BANKS; ++b) {
+                        std::vector<int> avail;
+                        for(int r=0; r<SR_NUM_LOGICAL_REGS; ++r) {
+                            if (st.valid_at_pred[b][r]) avail.push_back(r);
+                        }
+                        if (avail.empty()) continue;
+                        
+                        int r_train = avail[(PC + b) % avail.size()];
+                        uint16_t digest = st.all_digests[b][r_train];
+                        
+                        int h0 = hash_wt0(PC, digest);
+                        int h1 = hash_wt1(PC, digest);
+                        int h2 = hash_wt2(PC, digest);
+                        
+                        int8_t delta = resolveDir ? 1 : -1;
+                        WT0[b][h0] = sat(WT0[b][h0] + delta);
+                        WT1[b][h1] = sat(WT1[b][h1] + delta);
+                        WT2[b][h2] = sat(WT2[b][h2] + delta);
+                        
+                        int idx0 = hash_ut0(PC, b);
+                        int idx1 = hash_ut1(PC, b);
+                        int idx2 = hash_ut2(PC, b);
+                        
+                        bool pred_agrees = ((WT0[b][h0] + WT1[b][h1] + WT2[b][h2]) >= 0) == resolveDir;
+                        int8_t u_delta = pred_agrees ? 1 : -1;
+                        UT0[b][idx0][r_train] = sat(UT0[b][idx0][r_train] + u_delta);
+                        UT1[b][idx1][r_train] = sat(UT1[b][idx1][r_train] + u_delta);
+                        UT2[b][idx2][r_train] = sat(UT2[b][idx2][r_train] + u_delta);
+                    }
+                }
+                sR_pred_state.erase(it);
+            }
+        }
+        
+        update(PC, resolveDir, predDir, nextPC, pred_time_history);
+        pred_time_histories.erase(pred_hist_key);
+    }"""
+content = content.replace(old_update, new_update)
+
+with open('my_cond_branch_predictor.h', 'w') as f:
+    f.write(content)
