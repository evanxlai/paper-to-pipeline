+++ b/test_sr.cc
@@ -0,0 +1,124 @@
+#include <iostream>
+#include <cassert>
+#include <vector>
+#include <optional>
+
+struct DecodeInfo {
+    int insn_class;
+    std::vector<uint64_t> src_reg_info;
+    std::optional<uint64_t> dst_reg_info;
+};
+
+struct ExecuteInfo {
+    DecodeInfo dec_info;
+    std::optional<bool> taken;
+    uint64_t next_pc;
+    std::optional<uint64_t> taken_target, mem_va, mem_sz;
+    std::optional<uint64_t> dst_reg_value;
+};
+
+#include "my_cond_branch_predictor.h"
+
+int main() {
+    SampleCondPredictor p;
+    p.sr_enabled = true;
+    // test_int_digest_generation
+    uint64_t val = 42;
+    uint16_t dig = p.generate_digest(val, 1); // INT reg 1
+    if (dig != 0xB51) {
+        std::cerr << "INT digest failed: expected 0xB51, got 0x" << std::hex << dig << "\n";
+        return 1;
+    }
+    
+    // test_fp64_digest_generation
+    uint64_t fp_val = 0x17FULL << 55;
+    dig = p.generate_digest(fp_val, 32); // FP reg 32
+    if (dig != 0xBF8) {
+        std::cerr << "FP64 digest failed: expected 0xBF8, got 0x" << std::hex << dig << "\n";
+        return 1;
+    }
+    
+    // test_flag_digest_generation
+    uint64_t flag_val = 0x9;
+    dig = p.generate_digest(flag_val, 64); // FLAG reg 64
+    if (dig != 0x999) {
+        std::cerr << "FLAG digest failed: expected 0x999, got 0x" << std::hex << dig << "\n";
+        return 1;
+    }
+    
+
+    // test_staleness_invalidation
+    // Decode 256 instructions
+    DecodeInfo di;
+    di.dst_reg_info = 8;
+    p.notify_instr_decode(100, 0, di);
+    if (!p.reg_status_table[8].valid) {
+        // Wait, decode invalidates the register. Execute makes it valid.
+        ExecuteInfo ei;
+        ei.dec_info = di;
+        ei.dst_reg_value = 123;
+        p.notify_instr_execute_resolve(100, 0, ei);
+    }
+    assert(p.reg_status_table[8].valid == true);
+    for(int i=0; i<256; ++i) {
+        DecodeInfo di_empty;
+        p.notify_instr_decode(200+i, 0, di_empty);
+    }
+    if (p.reg_status_table[8].valid) {
+        std::cerr << "test_staleness_invalidation failed\n";
+        return 1;
+    }
+
+    // test_bank_usefulness_selection
+    // Bank 0 has valid R0 (UT sum = +5) and valid R8 (UT sum = +12).
+    p.reg_status_table[0].valid = true;
+    p.reg_status_table[0].payload = 0x111;
+    p.UT0[0][0][0] = 2; p.UT1[0][0][0] = 2; p.UT2[0][0][0] = 1; // sum 5
+    
+    p.reg_status_table[8].valid = true;
+    p.reg_status_table[8].payload = 0x222;
+    p.UT0[0][0][8] = 4; p.UT1[0][0][8] = 4; p.UT2[0][0][8] = 4; // sum 12
+    
+    SampleHist hist;
+    p.predict_using_given_hist(300, 0, 0, hist, true);
+    
+    // We expect bank 0 selected R8. 
+    // Wait, the pred state should capture best_reg
+    uint64_t uid = p.get_unique_inst_id(300, 0);
+    if (p.sR_pred_state[uid].best_regs[0] != 8) {
+        std::cerr << "test_bank_usefulness_selection failed\n";
+        return 1;
+    }
+
+    // test_multiplier_gating
+    // Bank 1 best valid register has net usefulness sum = -2; raw WT sum = +10
+    // expect: Bank 1 contribution is gated to 0
+    p.reg_status_table[1].valid = true;
+    p.reg_status_table[1].payload = 0x333;
+    p.UT0[1][1][1] = -1; p.UT1[1][2][1] = -1; p.UT2[1][4][1] = 0; // sum -2
+    p.WT0[1][p.hash_wt0(0, 0x333)] = 5;
+    p.WT1[1][p.hash_wt1(0, 0x333)] = 5;
+    p.WT2[1][p.hash_wt2(0, 0x333)] = 0; // sum 10
+    
+    // test_multiplier_activation
+    // Bank 2 best valid register has net usefulness sum = +3; raw WT sum = +8
+    // expect: Bank 2 contribution is scaled to 8 * 2.5 = 20
+    p.reg_status_table[2].valid = true;
+    p.reg_status_table[2].payload = 0x444;
+    p.UT0[2][2][2] = 1; p.UT1[2][4][2] = 1; p.UT2[2][0][2] = 1; // sum 3
+    p.WT0[2][p.hash_wt0(0, 0x444)] = 4;
+    p.WT1[2][p.hash_wt1(0, 0x444)] = 4;
+    p.WT2[2][p.hash_wt2(0, 0x444)] = 0; // sum 8
+
+    // The total sR_sum will be: Bank 1 gives 0, Bank 2 gives 20. Other banks 0.
+    // So total sR_sum = 20. Overrides false to true.
+    hist.tage_pred = false;
+    bool res = p.predict_using_given_hist(301, 0, 0, hist, true);
+    if (res != true) {
+        std::cerr << "Multiplier gating/activation failed\n";
+        return 1;
+    }
+    
+    std::cout << "All unit tests passed\n";
+    return 0;
+}
