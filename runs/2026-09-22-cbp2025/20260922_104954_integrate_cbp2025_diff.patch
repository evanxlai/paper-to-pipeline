diff --git a/fix.py b/fix.py
new file mode 100644
index 0000000..7bdd8e0
--- /dev/null
+++ b/fix.py
@@ -0,0 +1,243 @@
+content = """#ifndef _PREDICTOR_H_
+#define _PREDICTOR_H_
+
+#include <stdlib.h>
+#include <stdint.h>
+#include <unordered_map>
+#include <vector>
+#include <cassert>
+#include "sr_params.h"
+
+struct SampleHist {
+    uint64_t ghist;
+    bool tage_pred;
+    SampleHist() { ghist = 0; }
+};
+
+struct RegStatus {
+    bool valid;
+    uint16_t payload; 
+    uint16_t decay_ctr;
+    RegStatus() : valid(false), payload(0), decay_ctr(0) {}
+};
+
+class SampleCondPredictor {
+public:
+    SampleHist active_hist;
+    std::unordered_map<uint64_t, SampleHist> pred_time_histories;
+    
+    bool sr_enabled;
+    std::vector<RegStatus> reg_status_table;
+    
+    int8_t WT0[SR_NUM_BANKS][512];
+    int8_t WT1[SR_NUM_BANKS][256];
+    int8_t WT2[SR_NUM_BANKS][128];
+    
+    int8_t UT0[SR_NUM_BANKS][8][SR_NUM_LOGICAL_REGS];
+    int8_t UT1[SR_NUM_BANKS][8][SR_NUM_LOGICAL_REGS];
+    int8_t UT2[SR_NUM_BANKS][8][SR_NUM_LOGICAL_REGS];
+    
+    struct PredState {
+        int best_regs[SR_NUM_BANKS]; 
+        uint16_t digests[SR_NUM_BANKS];
+        bool valid_at_pred[SR_NUM_BANKS][SR_NUM_LOGICAL_REGS]; 
+    };
+    std::unordered_map<uint64_t, PredState> sR_pred_state;
+
+    SampleCondPredictor() {
+        reg_status_table.resize(SR_NUM_LOGICAL_REGS);
+        for(int b=0; b<SR_NUM_BANKS; ++b) {
+            for(int i=0; i<512; ++i) WT0[b][i] = 0;
+            for(int i=0; i<256; ++i) WT1[b][i] = 0;
+            for(int i=0; i<128; ++i) WT2[b][i] = 0;
+            for(int i=0; i<8; ++i) {
+                for(int r=0; r<SR_NUM_LOGICAL_REGS; ++r) {
+                    UT0[b][i][r] = 0;
+                    UT1[b][i][r] = 0;
+                    UT2[b][i][r] = 0;
+                }
+            }
+        }
+    }
+
+    void setup() {
+        const char* e = getenv("SR_SR_ENABLE");
+        sr_enabled = (e != nullptr && e[0] == '1');
+    }
+
+    void terminate() {}
+
+    uint16_t generate_digest(uint64_t val, uint64_t dest_reg) {
+        int reg_type;
+        if (dest_reg < 32) reg_type = 0;
+        else if (dest_reg < 64) reg_type = 3;
+        else reg_type = 4;
+        
+        if (reg_type == 0) {
+            int trailing_count = 0;
+            int leading_count = 0;
+            if (val == 0) {
+                trailing_count = 64; leading_count = 64;
+            } else if (val == 0xFFFFFFFFFFFFFFFFULL) {
+                trailing_count = 64; leading_count = 64;
+            } else {
+                uint64_t lsb = val & 1;
+                uint64_t t = lsb ? ~val : val;
+                trailing_count = __builtin_ctzll(t);
+                
+                uint64_t msb = val >> 63;
+                uint64_t l = msb ? ~val : val;
+                leading_count = __builtin_clzll(l);
+            }
+            
+            if (SR_ALGORITHMS_0_PSEUDOCODE_VARIANT_2 == 0) {
+                if (trailing_count > 63) trailing_count = 63;
+                if (leading_count > 63) leading_count = 63;
+            }
+            
+            uint64_t lsb6 = val & 0x3F;
+            uint16_t digest = (trailing_count & 0x3F) ^ ((leading_count & 0x3F) << 3) ^ ((lsb6 & 0x3F) << 6);
+            return digest & 0xFFF;
+        }
+        else if (reg_type == 3) {
+            return ((val >> 55) & 0x1FF) << 3;
+        }
+        else if (reg_type == 4) {
+            uint64_t flag4 = val & 0xF;
+            return flag4 | (flag4 << 4) | (flag4 << 8);
+        }
+        return 0;
+    }
+
+    void notify_instr_decode(uint64_t seq_no, uint8_t piece, const DecodeInfo& _decode_info) {
+        if (!sr_enabled) return;
+        if (_decode_info.dst_reg_info.has_value()) {
+            uint64_t dest_reg = _decode_info.dst_reg_info.value();
+            if (dest_reg < SR_NUM_LOGICAL_REGS) {
+                reg_status_table[dest_reg].valid = false;
+                reg_status_table[dest_reg].payload = get_unique_inst_id(seq_no, piece) & 0x3FFF;
+                reg_status_table[dest_reg].decay_ctr = 0;
+            }
+        }
+        for(int r = 0; r < SR_NUM_LOGICAL_REGS; ++r) {
+            if (reg_status_table[r].valid) {
+                if (reg_status_table[r].decay_ctr < SR_DECAY_THRESHOLD_INSTS - 1) {
+                    reg_status_table[r].decay_ctr++;
+                } else if (reg_status_table[r].decay_ctr == SR_DECAY_THRESHOLD_INSTS - 1) {
+                    reg_status_table[r].decay_ctr++;
+                    reg_status_table[r].valid = false;
+                }
+            }
+        }
+    }
+
+    void notify_instr_execute_resolve(uint64_t seq_no, uint8_t piece, const ExecuteInfo& _exec_info) {
+        if (!sr_enabled) return;
+        if (_exec_info.dst_reg_value.has_value() && _exec_info.dec_info.dst_reg_info.has_value()) {
+            uint64_t dest_reg = _exec_info.dec_info.dst_reg_info.value();
+            uint64_t val = _exec_info.dst_reg_value.value();
+            uint16_t rob_tag = get_unique_inst_id(seq_no, piece) & 0x3FFF;
+            
+            if (dest_reg < SR_NUM_LOGICAL_REGS) {
+                if (!reg_status_table[dest_reg].valid && reg_status_table[dest_reg].payload == rob_tag) {
+                    reg_status_table[dest_reg].payload = generate_digest(val, dest_reg);
+                    reg_status_table[dest_reg].valid = true;
+                    reg_status_table[dest_reg].decay_ctr = 0;
+                }
+            }
+        }
+    }
+
+    uint64_t get_unique_inst_id(uint64_t seq_no, uint8_t piece) const {
+        assert(piece < 16);
+        return (seq_no << 4) | (piece & 0x000F);
+    }
+
+    int hash_ut0(uint64_t PC, int bank) { return (PC ^ bank) % 8; }
+    int hash_ut1(uint64_t PC, int bank) { return (PC ^ (bank << 1)) % 8; }
+    int hash_ut2(uint64_t PC, int bank) { return (PC ^ (bank << 2)) % 8; }
+    int hash_wt0(uint64_t PC, uint16_t digest) { return (PC ^ digest) % 512; }
+    int hash_wt1(uint64_t PC, uint16_t digest) { return (PC ^ (digest << 1)) % 256; }
+    int hash_wt2(uint64_t PC, uint16_t digest) { return (PC ^ (digest << 2)) % 128; }
+
+    bool predict(uint64_t seq_no, uint8_t piece, uint64_t PC, const bool tage_pred) {
+        active_hist.tage_pred = tage_pred;
+        pred_time_histories.emplace(get_unique_inst_id(seq_no, piece), active_hist);
+        const bool pred_taken = predict_using_given_hist(seq_no, piece, PC, active_hist, true);
+        return pred_taken;
+    }
+
+    bool predict_using_given_hist(uint64_t seq_no, uint8_t piece, uint64_t PC, const SampleHist& hist_to_use, const bool pred_time_predict) {
+        if (!sr_enabled) return hist_to_use.tage_pred;
+        
+        int sR_sum = 0;
+        PredState st;
+        for(int b=0; b<SR_NUM_BANKS; ++b) {
+            st.best_regs[b] = -1;
+            st.digests[b] = 0;
+            for(int r=0; r<SR_NUM_LOGICAL_REGS; ++r) st.valid_at_pred[b][r] = false;
+            
+            int best_reg = -1;
+            int best_usefulness = -999999;
+            int idx0 = hash_ut0(PC, b);
+            int idx1 = hash_ut1(PC, b);
+            int idx2 = hash_ut2(PC, b);
+            
+            for(int r=0; r<SR_NUM_LOGICAL_REGS; ++r) {
+                if (r % 8 == b && reg_status_table[r].valid) {
+                    st.valid_at_pred[b][r] = true;
+                    int u = UT0[b][idx0][r] + UT1[b][idx1][r] + UT2[b][idx2][r];
+                    if (u > best_usefulness) {
+                        best_usefulness = u;
+                        best_reg = r;
+                    }
+                }
+            }
+            st.best_regs[b] = best_reg;
+            
+            int bank_contrib = 0;
+            if (best_reg != -1) {
+                st.digests[b] = reg_status_table[best_reg].payload & 0xFFF;
+                if (best_usefulness > 0) {
+                    uint16_t digest = st.digests[b];
+                    int h0 = hash_wt0(PC, digest);
+                    int h1 = hash_wt1(PC, digest);
+                    int h2 = hash_wt2(PC, digest);
+                    int raw_wt_sum = WT0[b][h0] + WT1[b][h1] + WT2[b][h2];
+                    bank_contrib = (raw_wt_sum * 5) / 2;
+                }
+            }
+            sR_sum += bank_contrib;
+        }
+        
+        if (pred_time_predict) {
+            sR_pred_state[get_unique_inst_id(seq_no, piece)] = st;
+        }
+        
+        if (sR_sum > 0) return true;
+        if (sR_sum < 0) return false;
+        
+        return hist_to_use.tage_pred;
+    }
+
+    void history_update(uint64_t seq_no, uint8_t piece, uint64_t PC, bool taken, uint64_t nextPC) {
+        active_hist.ghist = active_hist.ghist << 1;
+        if(taken) active_hist.ghist |= 1;
+    }
+
+    void update(uint64_t seq_no, uint8_t piece, uint64_t PC, bool resolveDir, bool predDir, uint64_t nextPC) {
+        const auto pred_hist_key = get_unique_inst_id(seq_no, piece);
+        const auto& pred_time_history = pred_time_histories.at(pred_hist_key);
+        update(PC, resolveDir, predDir, nextPC, pred_time_history);
+        pred_time_histories.erase(pred_hist_key);
+    }
+
+    void update(uint64_t PC, bool resolveDir, bool pred_taken, uint64_t nextPC, const SampleHist& hist_to_use) {
+    }
+};
+
+#endif
+static SampleCondPredictor cond_predictor_impl;
+"""
+with open("my_cond_branch_predictor.h", "w") as f:
+    f.write(content)
