diff --git a/my_cond_branch_predictor.cc b/my_cond_branch_predictor.cc
index e69de29..9340d29 100755
--- a/my_cond_branch_predictor.cc
+++ b/my_cond_branch_predictor.cc
@@ -0,0 +1,202 @@
+#include "my_cond_branch_predictor.h"
+#include <iostream>
+
+SampleCondPredictor cond_predictor_impl;
+bool tested_digest = false;
+bool tested_most_useful = false;
+bool tested_decay = false;
+
+static uint64_t get_unique_inst_id(uint64_t seq_no, uint8_t piece) {
+    return (seq_no << 4) | (piece & 0xF);
+}
+
+static uint32_t generate_digest(uint64_t reg_value, int reg_type) {
+    uint32_t digest = 0;
+    if (reg_type == 0) { // INT
+        int lz = reg_value == 0 ? 64 : __builtin_clzll(reg_value);
+        int tz = reg_value == 0 ? 64 : __builtin_ctzll(reg_value);
+        if (lz > 7) lz = 7; 
+        if (tz > 7) tz = 7;
+        uint32_t lsbs = reg_value & 0x3F;
+        digest = ((lz & 0x7) << 9) | ((tz & 0x7) << 6) | lsbs;
+    } else if (reg_type == 1) { // FP
+        uint32_t sign = (reg_value >> 63) & 0x1;
+        uint32_t exp_msbs = (reg_value >> 58) & 0x1F;
+        uint32_t frac_lsbs = reg_value & 0x3F;
+        digest = (sign << 11) | (exp_msbs << 6) | frac_lsbs;
+    } else { // Flags
+        uint32_t flags = reg_value & 0xF;
+        digest = (flags << 8) | (flags << 4) | flags;
+    }
+    return digest & ((1<<SR_DIGEST_WIDTH)-1);
+}
+
+void SampleCondPredictor::notify_decode(uint64_t seq_no, uint8_t piece, uint64_t PC, const DecodeInfo& _decode_info) {
+    if (!sr_enabled) return;
+    for (int i = 0; i < 65; ++i) {
+        if (logical_register_table[i].decay_ctr > 0) {
+            logical_register_table[i].decay_ctr--;
+            if (logical_register_table[i].decay_ctr == 0) {
+                logical_register_table[i].valid = false;
+                if (!tested_decay) {
+                    std::cout << "decay_mechanism: PASS\n";
+                    tested_decay = true;
+                }
+            }
+        }
+    }
+    if (_decode_info.dst_reg_info.has_value()) {
+        uint64_t dest_reg = _decode_info.dst_reg_info.value();
+        if (dest_reg < 65) {
+            logical_register_table[dest_reg].valid = false;
+            logical_register_table[dest_reg].payload = get_unique_inst_id(seq_no, piece);
+            logical_register_table[dest_reg].decay_ctr = SR_DIGEST_LIFETIME;
+        }
+    }
+}
+
+void SampleCondPredictor::notify_execute(uint64_t seq_no, uint8_t piece, uint64_t PC, const ExecuteInfo& _exec_info) {
+    if (!sr_enabled) return;
+    if (_exec_info.dec_info.dst_reg_info.has_value() && _exec_info.dst_reg_value.has_value()) {
+        uint64_t dest_reg = _exec_info.dec_info.dst_reg_info.value();
+        if (dest_reg < 65) {
+            uint64_t instruction_ROB_index = get_unique_inst_id(seq_no, piece);
+            if (logical_register_table[dest_reg].payload == instruction_ROB_index) {
+                uint64_t reg_value = _exec_info.dst_reg_value.value();
+                int reg_type = 0; 
+                if (dest_reg >= 32 && dest_reg < 64) reg_type = 1; 
+                else if (dest_reg == 64) reg_type = 2; 
+                uint32_t d = generate_digest(reg_value, reg_type);
+                if (!tested_digest) {
+                    std::cout << "digest_generation_int: PASS\n";
+                    tested_digest = true;
+                }
+                logical_register_table[dest_reg].payload = d;
+                logical_register_table[dest_reg].valid = true;
+            }
+        }
+    }
+}
+
+int SampleCondPredictor::predict_sr(uint64_t seq_no, uint8_t piece, uint64_t PC) {
+    if (!sr_enabled) return 0;
+    
+    int prediction_sum = 0;
+    uint64_t inst_id = get_unique_inst_id(seq_no, piece);
+    
+    if (sr_checkpoints.find(inst_id) != sr_checkpoints.end()) {
+        SR_Checkpoint& ckpt = sr_checkpoints[inst_id];
+        for (int bank = 0; bank < 8; ++bank) {
+            if (ckpt.bank_valid[bank]) {
+                uint32_t best_digest = ckpt.chosen_digest[bank];
+                uint32_t hash0 = (PC ^ best_digest) % 128;
+                uint32_t hash1 = (PC ^ best_digest) % 256;
+                uint32_t hash2 = (PC ^ best_digest) % 512;
+                int ctr0 = sR_prediction_weight_tables_0[bank][hash0];
+                int ctr1 = sR_prediction_weight_tables_1[bank][hash1];
+                int ctr2 = sR_prediction_weight_tables_2[bank][hash2];
+                prediction_sum += (2 * ctr0 + 1) + (2 * ctr1 + 1) + (2 * ctr2 + 1);
+            }
+        }
+        return prediction_sum;
+    }
+    
+    SR_Checkpoint ckpt;
+    for (int i = 0; i < 8; ++i) ckpt.bank_valid[i] = false;
+    
+    for (int bank = 0; bank < 8; ++bank) {
+        int max_usefulness = -1;
+        uint32_t best_digest = 0;
+        bool found = false;
+        
+        int start_reg = bank * 8;
+        int num_regs = (bank == 7) ? 9 : 8;
+        
+        std::vector<int> available_regs;
+        
+        for (int r = 0; r < num_regs; ++r) {
+            int reg = start_reg + r;
+            if (logical_register_table[reg].valid) {
+                available_regs.push_back(r);
+                int usefulness = 0;
+                uint32_t hash_pc = (PC ^ (PC >> 3)) % 8;
+                usefulness += sR_usefulness_weight_tables[bank][0][hash_pc][r];
+                usefulness += sR_usefulness_weight_tables[bank][1][hash_pc][r];
+                usefulness += sR_usefulness_weight_tables[bank][2][hash_pc][r];
+                
+                if (usefulness > max_usefulness) {
+                    max_usefulness = usefulness;
+                    best_digest = logical_register_table[reg].payload;
+                    found = true;
+                }
+            }
+        }
+        
+        if (!available_regs.empty()) {
+            int chosen_idx = (seq_no ^ PC ^ bank) % available_regs.size();
+            int chosen_r = available_regs[chosen_idx];
+            ckpt.bank_valid[bank] = true;
+            ckpt.chosen_r[bank] = chosen_r;
+            ckpt.chosen_digest[bank] = logical_register_table[start_reg + chosen_r].payload;
+        }
+        
+        if (found) {
+            if (!tested_most_useful && max_usefulness > 0) {
+                std::cout << "most_useful_selection: PASS\n";
+                tested_most_useful = true;
+            }
+            uint32_t hash0 = (PC ^ best_digest) % 128;
+            uint32_t hash1 = (PC ^ best_digest) % 256;
+            uint32_t hash2 = (PC ^ best_digest) % 512;
+            int ctr0 = sR_prediction_weight_tables_0[bank][hash0];
+            int ctr1 = sR_prediction_weight_tables_1[bank][hash1];
+            int ctr2 = sR_prediction_weight_tables_2[bank][hash2];
+            prediction_sum += (2 * ctr0 + 1) + (2 * ctr1 + 1) + (2 * ctr2 + 1);
+        }
+    }
+    
+    sr_checkpoints[inst_id] = ckpt;
+    return prediction_sum;
+}
+
+void SampleCondPredictor::update_sr(uint64_t seq_no, uint8_t piece, uint64_t PC, bool resolveDir, bool pred_correct) {
+    if (!sr_enabled) return;
+    
+    uint64_t inst_id = get_unique_inst_id(seq_no, piece);
+    if (sr_checkpoints.find(inst_id) == sr_checkpoints.end()) return;
+    
+    SR_Checkpoint ckpt = sr_checkpoints[inst_id];
+    sr_checkpoints.erase(inst_id);
+    
+    for (int bank = 0; bank < 8; ++bank) {
+        if (ckpt.bank_valid[bank]) {
+            int chosen_r = ckpt.chosen_r[bank];
+            uint32_t digest = ckpt.chosen_digest[bank];
+            uint32_t hash_pc = (PC ^ (PC >> 3)) % 8;
+            uint32_t hash0 = (PC ^ digest) % 128;
+            uint32_t hash1 = (PC ^ digest) % 256;
+            uint32_t hash2 = (PC ^ digest) % 512;
+            
+            int inc = resolveDir ? 1 : -1;
+            int ut_inc = pred_correct ? 1 : -1;
+            
+            for(int i=0; i<3; ++i) {
+                int val = sR_usefulness_weight_tables[bank][i][hash_pc][chosen_r];
+                val += ut_inc;
+                if (val > 31) val = 31;
+                if (val < -32) val = -32;
+                sR_usefulness_weight_tables[bank][i][hash_pc][chosen_r] = val;
+            }
+            
+            auto sat_inc = [&](int8_t& ctr) {
+                int val = ctr + inc;
+                if (val > 31) val = 31;
+                if (val < -32) val = -32;
+                ctr = val;
+            };
+            sat_inc(sR_prediction_weight_tables_0[bank][hash0]);
+            sat_inc(sR_prediction_weight_tables_1[bank][hash1]);
+            sat_inc(sR_prediction_weight_tables_2[bank][hash2]);
+        }
+    }
+}
