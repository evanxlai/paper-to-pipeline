+// generated from the feature spec and the port plan; DSE mutates values only
+#pragma once
+#define SR_NUM_BANKS 8  // range: [1, 16]
+#define SR_WT0_ENTRIES 512  // range: [128, 2048] pow2
+#define SR_WT1_ENTRIES 256  // range: [64, 1024] pow2
+#define SR_WT2_ENTRIES 128  // range: [32, 512] pow2
+#define SR_WT_CTR_BITS 6  // range: [3, 8]
+#define SR_UT_ENTRIES 8  // range: [4, 32] pow2
+#define SR_UT_CTR_BITS 6  // range: [2, 8]
+#define SR_DIGEST_WIDTH 12  // range: [4, 12]
+#define SR_ROB_TAG_BITS 14  // range: [10, 16]
+#define SR_DECAY_INTERVAL 256  // range: [32, 2048] pow2
+#define SR_MULTIPLIER_USEFUL 2.5  // range: [1.0, 4.0]
+#define SR_USEFULNESS_THRESHOLD 0  // range: [-16, 16]
+// host knobs: the host's own structures, at the clean tree's values by default
+#define HOST_LOGG 10  // range: [8, 12]; sets LOGG
+#define HOST_TBITS 8  // range: [6, 12]; sets TBITS
+#define HOST_NBANKLOW 10  // range: [4, 16]; sets NBANKLOW
+#define HOST_NBANKHIGH 20  // range: [10, 32]; sets NBANKHIGH
+#define HOST_CWIDTH 3  // range: [2, 4]; sets CWIDTH
+#define HOST_UWIDTH 1  // range: [1, 2]; sets UWIDTH
+#define HOST_LOGB 13  // range: [10, 15]; sets LOGB
+#define HOST_HYSTSHIFT 2  // range: [0, 4]; sets HYSTSHIFT
+#define HOST_PERCWIDTH 6  // range: [4, 8]; sets PERCWIDTH
+#define HOST_LOGBIAS 8  // range: [4, 10]; sets LOGBIAS
+#define HOST_LOGGNB 10  // range: [6, 12]; sets LOGGNB
+#define HOST_LOGPNB 9  // range: [6, 12]; sets LOGPNB
+#define HOST_LOGLNB 10  // range: [6, 12]; sets LOGLNB
+#define HOST_LOGSNB 9  // range: [6, 12]; sets LOGSNB
+#define HOST_LOGTNB 10  // range: [6, 12]; sets LOGTNB
+#define HOST_LOGINB 8  // range: [4, 12]; sets LOGINB
+#define HOST_LOGIMNB 9  // range: [4, 12]; sets LOGIMNB
+#define HOST_LOGL 5  // range: [3, 8]; sets LOGL
+#define HOST_EWIDTH 6  // range: [4, 8]; sets EWIDTH
diff --git a/test_sr.cc b/test_sr.cc
new file mode 100644
index 0000000..cec3823
--- /dev/null
+++ b/test_sr.cc
@@ -0,0 +1,139 @@
+
+#include "my_cond_branch_predictor.h"
+#include <iostream>
+#include <cassert>
+
+extern SampleCondPredictor cond_predictor_impl;
+
+int main(int argc, char** argv) {
+    if (argc < 2) return 1;
+    int test_id = std::stoi(argv[1]);
+    
+    cond_predictor_impl.setup();
+
+    if (test_id == 0) {
+        uint32_t d = cond_predictor_impl.generate_digest(0x0000000000000000, 0); // INT
+        assert(d == 0x1C7);
+    } else if (test_id == 1) {
+        uint32_t d = cond_predictor_impl.generate_digest(0x0000000000000042, 0); // INT
+        assert(d == 0x149);
+    } else if (test_id == 2) {
+        uint32_t d = cond_predictor_impl.generate_digest(0x3FF0000000000000, 1); // FP
+        assert(d == 0x07F);
+    } else if (test_id == 3) {
+        uint32_t d = cond_predictor_impl.generate_digest(0x000000003F800000, 1); // FP
+        assert(d == 0x00F);
+    } else if (test_id == 4) {
+        uint32_t d = cond_predictor_impl.generate_digest(0b1001, 2); // FLAG
+        assert(d == 0x999);
+    } else if (test_id == 5) {
+        uint32_t folded = cond_predictor_impl.fold(0x149, 6);
+        assert(folded == 0x0C);
+    } else if (test_id == 6) {
+        cond_predictor_impl.on_instruction_decode(0, 100);
+        cond_predictor_impl.on_instruction_writeback(0, 100, 0, 0);
+        assert(cond_predictor_impl.reg_status[0].valid == true);
+        assert(cond_predictor_impl.reg_status[0].decay_ctr == 255);
+        for(int i = 0; i < 255; ++i) {
+            cond_predictor_impl.on_instruction_decode(1, 101+i);
+        }
+        assert(cond_predictor_impl.reg_status[0].valid == true);
+        assert(cond_predictor_impl.reg_status[0].decay_ctr == 0);
+        cond_predictor_impl.on_instruction_decode(1, 999);
+        assert(cond_predictor_impl.reg_status[0].valid == false);
+    } else if (test_id == 7) {
+        cond_predictor_impl.on_instruction_decode(3, 5); // instr A
+        cond_predictor_impl.on_instruction_decode(3, 9); // instr B
+        // A completes
+        cond_predictor_impl.on_instruction_writeback(3, 5, 0, 0);
+        assert(cond_predictor_impl.reg_status[3].valid == false); // still pending
+        assert(cond_predictor_impl.reg_status[3].payload == 9);
+        // B completes
+        cond_predictor_impl.on_instruction_writeback(3, 9, 0, 0);
+        assert(cond_predictor_impl.reg_status[3].valid == true);
+    } else if (test_id == 8) {
+        assert((0 % SR_NUM_BANKS) == 0);
+        assert((8 % SR_NUM_BANKS) == 0);
+        assert((64 % SR_NUM_BANKS) == 0);
+        assert((64 / SR_NUM_BANKS) == 8); // 9th slot
+        assert((1 % SR_NUM_BANKS) == 1);
+        assert((9 % SR_NUM_BANKS) == 1);
+        assert((57 % SR_NUM_BANKS) == 1);
+    } else if (test_id == 9) {
+        cond_predictor_impl.reg_status[0].valid = true; cond_predictor_impl.reg_status[0].payload = 0;
+        cond_predictor_impl.reg_status[8].valid = true; cond_predictor_impl.reg_status[8].payload = 1;
+        cond_predictor_impl.ut[0][0][0][0] = 5;
+        cond_predictor_impl.ut[0][0][0][1] = 18;
+        cond_predictor_impl.wt0[0][cond_predictor_impl.wt_idx(0, 0, 1)] = 10;
+        cond_predictor_impl.wt0[0][cond_predictor_impl.wt_idx(0, 0, 0)] = -10;
+        
+        cond_predictor_impl.sr_predict_at_pred(0, 0, 0);
+        assert(cond_predictor_impl.active_hist.sr_bank_contrib[0] > 0); 
+        
+        cond_predictor_impl.ut[0][0][0][0] = 7;
+        cond_predictor_impl.ut[0][0][0][1] = 7;
+        cond_predictor_impl.sr_predict_at_pred(0, 0, 0);
+        assert(cond_predictor_impl.active_hist.sr_bank_contrib[0] < 0);
+    } else if (test_id == 10) {
+        cond_predictor_impl.reg_status[1].valid = true; cond_predictor_impl.reg_status[1].payload = 0;
+        cond_predictor_impl.ut[1][0][0][0] = -4; // slot 0 for R1 in bank 1
+        cond_predictor_impl.sr_predict_at_pred(0, 0, 0);
+        assert(cond_predictor_impl.active_hist.sr_bank_contrib[1] == 0);
+    } else if (test_id == 11) {
+        cond_predictor_impl.reg_status[2].valid = true; cond_predictor_impl.reg_status[2].payload = 0;
+        cond_predictor_impl.ut[2][0][0][0] = 0;
+        cond_predictor_impl.wt0[2][cond_predictor_impl.wt_idx(0, 0, 0)] = 3;
+        cond_predictor_impl.wt1[2][cond_predictor_impl.wt_idx(1, 0, 0)] = -1;
+        cond_predictor_impl.wt2[2][cond_predictor_impl.wt_idx(2, 0, 0)] = 0;
+        cond_predictor_impl.sr_predict_at_pred(0, 0, 0);
+        assert(cond_predictor_impl.active_hist.sr_bank_contrib[2] == 17);
+    } else if (test_id == 12) {
+        cond_predictor_impl.prng_state = 12345;
+        SampleHist hist;
+        hist.sr_snap[3].valid = true;
+        hist.sr_snap[3].digest = 1;
+        hist.sr_snap[11].valid = true;
+        hist.sr_snap[11].digest = 2;
+        hist.sr_snap[19].valid = false;
+        
+        cond_predictor_impl.pred_time_histories.emplace(cond_predictor_impl.get_unique_inst_id(0, 0), hist);
+        
+        cond_predictor_impl.reg_status[19].valid = true;
+        
+        cond_predictor_impl.wt0[3][cond_predictor_impl.wt_idx(0, 0, 1)] = 0;
+        cond_predictor_impl.wt0[3][cond_predictor_impl.wt_idx(0, 0, 2)] = 0;
+        
+        cond_predictor_impl.sr_update(0, 0, 0, true, 0); // taken
+        
+        int w3 = cond_predictor_impl.wt0[3][cond_predictor_impl.wt_idx(0, 0, 1)];
+        int w11 = cond_predictor_impl.wt0[3][cond_predictor_impl.wt_idx(0, 0, 2)];
+        assert((w3 == 1 && w11 == 0) || (w3 == 0 && w11 == 1));
+    } else if (test_id == 13) {
+        SampleHist hist;
+        hist.sr_snap[0].valid = true;
+        hist.sr_snap[0].digest = 0;
+        hist.sr_bank_contrib[0] = -25; // to simulate earlier predict
+        cond_predictor_impl.pred_time_histories.emplace(cond_predictor_impl.get_unique_inst_id(0, 1), hist);
+        
+        cond_predictor_impl.wt0[0][cond_predictor_impl.wt_idx(0, 0, 0)] = -5;
+        cond_predictor_impl.wt1[0][cond_predictor_impl.wt_idx(1, 0, 0)] = 0;
+        cond_predictor_impl.wt2[0][cond_predictor_impl.wt_idx(2, 0, 0)] = -1;
+        
+        cond_predictor_impl.ut[0][0][0][0] = 0;
+        
+        // Case 1: rest = 40. lsum = 40 + (-25) = 15
+        cond_predictor_impl.sr_update(0, 1, 0, false, 15);
+        assert(cond_predictor_impl.ut[0][0][0][0] == 0); // unchanged
+        
+        SampleHist hist2;
+        hist2.sr_snap[0].valid = true;
+        hist2.sr_snap[0].digest = 0;
+        hist2.sr_bank_contrib[0] = -22;
+        cond_predictor_impl.pred_time_histories.emplace(cond_predictor_impl.get_unique_inst_id(0, 2), hist2);
+        
+        // Case 2: rest = 10. lsum = 10 + (-22) = -12
+        cond_predictor_impl.sr_update(0, 2, 0, false, -12);
+        assert(cond_predictor_impl.ut[0][0][0][0] == 1); // trained because p < 0 matches not taken
+    }
+    return 0;
+}
