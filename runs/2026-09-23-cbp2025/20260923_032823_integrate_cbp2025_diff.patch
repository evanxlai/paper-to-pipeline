+++ b/fix_h.py
@@ -0,0 +1,109 @@
+import sys
+
+with open('my_cond_branch_predictor.h', 'r') as f:
+    content = f.read()
+
+old_sr_predict = """        int sr_predict(uint64_t pc, const std::array<SRSnapshotEntry, 65>& snap, std::array<int, SR_NUM_BANKS>& bank_contrib) const {"""
+
+new_sr_predict = """        int sr_predict(uint64_t pc) {
+            snapshot_status_table(active_hist.sr_snap);
+            auto& snap = active_hist.sr_snap;
+            auto& bank_contrib = active_hist.sr_bank_contrib;
+            int sr_total = 0;"""
+
+content = content.replace(old_sr_predict, new_sr_predict)
+
+# Also fix the return type of sr_predict and any const qualifier
+# Wait, sr_predict in old was:
+# int sr_predict(uint64_t pc, const std::array<SRSnapshotEntry, 65>& snap, std::array<int, SR_NUM_BANKS>& bank_contrib) const {
+# Let's replace the whole method to be safe.
+
+old_method = """        int sr_predict(uint64_t pc, const std::array<SRSnapshotEntry, 65>& snap, std::array<int, SR_NUM_BANKS>& bank_contrib) const {
+            int sr_total = 0;
+            for (int b = 0; b < SR_NUM_BANKS; ++b) {
+                int best_reg = -1;
+                int max_useful = 0;
+                for (int r = b; r <= 64; r += SR_NUM_BANKS) {
+                    if (snap[r].valid) {
+                        int s = r / SR_NUM_BANKS;
+                        int useful_sum = 0;
+                        for (int t = 0; t < 3; ++t) {
+                            int u = ut_idx(t, pc);
+                            useful_sum += ut[b][t][u][s];
+                        }
+                        if (best_reg < 0 || useful_sum > max_useful) {
+                            max_useful = useful_sum;
+                            best_reg = r;
+                        }
+                    }
+                }
+                bank_contrib[b] = 0;
+                if (best_reg >= 0 && max_useful >= SR_USEFULNESS_THRESHOLD) {
+                    uint32_t d = snap[best_reg].digest;
+                    int p = 0;
+                    
+                    int w0 = wt_idx(0, pc, d);
+                    p += (2 * wt0[b][w0] + 1);
+                    
+                    int w1 = wt_idx(1, pc, d);
+                    p += (2 * wt1[b][w1] + 1);
+                    
+                    int w2 = wt_idx(2, pc, d);
+                    p += (2 * wt2[b][w2] + 1);
+                    
+                    bank_contrib[b] = (int)(p * SR_MULTIPLIER_USEFUL); // trunc toward zero
+                }
+                sr_total += bank_contrib[b];
+            }
+            return sr_total;
+        }"""
+
+new_method = """        int sr_predict(uint64_t pc) {
+            snapshot_status_table(active_hist.sr_snap);
+            auto& snap = active_hist.sr_snap;
+            auto& bank_contrib = active_hist.sr_bank_contrib;
+
+            int sr_total = 0;
+            for (int b = 0; b < SR_NUM_BANKS; ++b) {
+                int best_reg = -1;
+                int max_useful = 0;
+                for (int r = b; r <= 64; r += SR_NUM_BANKS) {
+                    if (snap[r].valid) {
+                        int s = r / SR_NUM_BANKS;
+                        int useful_sum = 0;
+                        for (int t = 0; t < 3; ++t) {
+                            int u = ut_idx(t, pc);
+                            useful_sum += ut[b][t][u][s];
+                        }
+                        if (best_reg < 0 || useful_sum > max_useful) {
+                            max_useful = useful_sum;
+                            best_reg = r;
+                        }
+                    }
+                }
+                bank_contrib[b] = 0;
+                if (best_reg >= 0 && max_useful >= SR_USEFULNESS_THRESHOLD) {
+                    uint32_t d = snap[best_reg].digest;
+                    int p = 0;
+                    
+                    int w0 = wt_idx(0, pc, d);
+                    p += (2 * wt0[b][w0] + 1);
+                    
+                    int w1 = wt_idx(1, pc, d);
+                    p += (2 * wt1[b][w1] + 1);
+                    
+                    int w2 = wt_idx(2, pc, d);
+                    p += (2 * wt2[b][w2] + 1);
+                    
+                    bank_contrib[b] = (int)(p * SR_MULTIPLIER_USEFUL); // trunc toward zero
+                }
+                sr_total += bank_contrib[b];
+            }
+            return sr_total;
+        }"""
+
+content = content.replace(old_method, new_method)
+
+with open('my_cond_branch_predictor.h', 'w') as f:
+    f.write(content)
+
