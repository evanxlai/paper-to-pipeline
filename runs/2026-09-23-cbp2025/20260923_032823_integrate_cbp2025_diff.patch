+        }"""
+content = content.replace(old_pred, new_pred)
+
+# Fix predict
+old_predict = """        bool predict (uint64_t seq_no, uint8_t piece, uint64_t PC, const bool tage_pred)
+        {
+            active_hist.tage_pred = tage_pred;
+            snapshot_status_table(active_hist.sr_snap);
+            // checkpoint current hist
+            pred_time_histories.emplace(get_unique_inst_id(seq_no, piece), active_hist);
