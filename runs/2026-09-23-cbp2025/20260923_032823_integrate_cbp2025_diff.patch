+                uint32_t lead_count = count_leading(val, lead_bit);
+                if (lead_count > 63) lead_count = 63;
+                bool trail_bit = val & 1;
+                uint32_t trail_count = count_trailing(val, trail_bit);
+                if (trail_count > 63) trail_count = 63;
+                raw = ((low6 << 6) ^ (lead_count << 3) ^ trail_count) & 0xFFF;
+            } else if (reg_type == 1) { // FP
