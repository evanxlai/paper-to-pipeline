+            bool valid;
+            uint32_t payload;
+            uint32_t decay_ctr;
+        } reg_status[65];
+
+        int8_t ut[SR_NUM_BANKS][3][SR_UT_ENTRIES][65 / SR_NUM_BANKS + 1];
+        int8_t wt0[SR_NUM_BANKS][SR_WT0_ENTRIES];
+        int8_t wt1[SR_NUM_BANKS][SR_WT1_ENTRIES];
+        int8_t wt2[SR_NUM_BANKS][SR_WT2_ENTRIES];
+        
+        uint64_t prng_state;
+
+        uint64_t prng_next() {
+            // A simple LCG or Xorshift
+            prng_state = prng_state * 6364136223846793005ULL + 1442695040888963407ULL;
+            return prng_state;
+        }
+
+        uint32_t fold(uint32_t x, int k) const {
+            uint32_t folded = 0;
+            while (x != 0) {
+                folded ^= (x & ((1 << k) - 1));
+                x >>= k;
+            }
+            return folded;
+        }
+
+        void sat_update(int8_t& ctr, bool up, int bits) {
+            int max_val = (1 << (bits - 1)) - 1;
+            int min_val = -(1 << (bits - 1));
+            if (up) {
+                if (ctr < max_val) ctr++;
+            } else {
+                if (ctr > min_val) ctr--;
+            }
+        }
+
+        uint32_t ut_idx(int t, uint64_t pc) const {
+            return (pc ^ (pc >> (3 * (t + 1)))) & (SR_UT_ENTRIES - 1);
+        }
+
+        uint32_t wt_idx(int t, uint64_t pc, uint32_t d) const {
+            int n = (t == 0) ? SR_WT0_ENTRIES : ((t == 1) ? SR_WT1_ENTRIES : SR_WT2_ENTRIES);
+            int k = 0;
+            while ((1 << k) < n) k++; // Assuming n is a power of 2
+            return (pc ^ (pc >> k) ^ fold(d, k)) & (n - 1);
+        }
+
+        int count_leading(uint64_t val, bool b) const {
+            if (b) val = ~val;
+            if (val == 0) return 64;
+            return __builtin_clzll(val);
+        }
+
+        int count_trailing(uint64_t val, bool b) const {
+            if (b) val = ~val;
+            if (val == 0) return 64;
+            return __builtin_ctzll(val);
+        }
+
+        uint32_t generate_digest(uint64_t val, int reg_type) const {
+            uint32_t raw = 0;
+            if (reg_type == 0) { // INT
+                uint32_t low6 = val & 0x3F;
+                bool lead_bit = (val >> 63) & 1;
+                uint32_t lead_count = count_leading(val, lead_bit);
+                if (lead_count > 63) lead_count = 63;
+                bool trail_bit = val & 1;
+                uint32_t trail_count = count_trailing(val, trail_bit);
+                if (trail_count > 63) trail_count = 63;
+                raw = ((low6 << 6) ^ (lead_count << 3) ^ trail_count) & 0xFFF;
+            } else if (reg_type == 1) { // FP
+                if ((val >> 32) != 0) {
+                    raw = (val >> 55) & 0x1FF;
+                } else if ((val >> 16) != 0) {
+                    raw = (val >> 26) & 0x3F;
+                } else {
+                    raw = (val >> 13) & 0x7;
+                }
+            } else { // FLAG
+                uint32_t flag4 = val & 0xF;
+                raw = (flag4 << 8) | (flag4 << 4) | flag4;
+            }
+            return fold(raw, SR_DIGEST_WIDTH);
+        }
+
+        void on_instruction_decode(int dest_reg, uint64_t rob_tag) {
+            for (int r = 0; r <= 64; ++r) {
+                if (reg_status[r].valid) {
+                    if (reg_status[r].decay_ctr == 0) {
+                        reg_status[r].valid = false;
+                    } else {
+                        reg_status[r].decay_ctr--;
+                    }
+                }
+            }
+            if (dest_reg >= 0 && dest_reg <= 64) {
+                reg_status[dest_reg].valid = false;
+                reg_status[dest_reg].payload = rob_tag & ((1 << SR_ROB_TAG_BITS) - 1);
+                reg_status[dest_reg].decay_ctr = 0;
+            }
+        }
+
+        void on_instruction_writeback(int dest_reg, uint64_t rob_tag, uint64_t val, int reg_type) {
+            if (dest_reg >= 0 && dest_reg <= 64) {
+                uint32_t tag = rob_tag & ((1 << SR_ROB_TAG_BITS) - 1);
+                if (!reg_status[dest_reg].valid && reg_status[dest_reg].payload == tag) {
+                    reg_status[dest_reg].payload = generate_digest(val, reg_type);
+                    reg_status[dest_reg].decay_ctr = SR_DECAY_INTERVAL - 1;
+                    reg_status[dest_reg].valid = true;
+                }
+            }
+        }
+
+        void snapshot_status_table(std::array<SRSnapshotEntry, 65>& snap) const {
+            for (int r = 0; r <= 64; ++r) {
+                snap[r].valid = reg_status[r].valid;
+                snap[r].digest = reg_status[r].payload & ((1 << SR_DIGEST_WIDTH) - 1);
+            }
+        }
+
+        int sr_predict(uint64_t pc, const std::array<SRSnapshotEntry, 65>& snap, std::array<int, SR_NUM_BANKS>& bank_contrib) const {
+            int sr_total = 0;
+            for (int b = 0; b < SR_NUM_BANKS; ++b) {
+                int best_reg = -1;
+                int max_useful = 0;
+                for (int r = b; r <= 64; r += SR_NUM_BANKS) {
+                    if (snap[r].valid) {
+                        int s = r / SR_NUM_BANKS;
+                        int useful_sum = 0;
+                        for (int t = 0; t < 3; ++t) {
+                            int u = ut_idx(t, pc);
+                            useful_sum += ut[b][t][u][s];
+                        }
+                        if (best_reg < 0 || useful_sum > max_useful) {
+                            max_useful = useful_sum;
+                            best_reg = r;
+                        }
+                    }
+                }
+                bank_contrib[b] = 0;
+                if (best_reg >= 0 && max_useful >= SR_USEFULNESS_THRESHOLD) {
+                    uint32_t d = snap[best_reg].digest;
+                    int p = 0;
+                    
+                    int w0 = wt_idx(0, pc, d);
+                    p += (2 * wt0[b][w0] + 1);
+                    
+                    int w1 = wt_idx(1, pc, d);
+                    p += (2 * wt1[b][w1] + 1);
+                    
+                    int w2 = wt_idx(2, pc, d);
+                    p += (2 * wt2[b][w2] + 1);
+                    
+                    bank_contrib[b] = (int)(p * SR_MULTIPLIER_USEFUL); // trunc toward zero
+                }
+                sr_total += bank_contrib[b];
+            }
+            return sr_total;
+        }
+
+        void sr_update(uint64_t seq_no, uint8_t piece, uint64_t pc, bool taken, int lsum) {
+            uint64_t pred_hist_key = get_unique_inst_id(seq_no, piece);
+            if (pred_time_histories.find(pred_hist_key) == pred_time_histories.end()) return;
+            const auto& hist = pred_time_histories.at(pred_hist_key);
+            const auto& snap = hist.sr_snap;
+            const auto& bank_contrib = hist.sr_bank_contrib;
+
+            for (int b = 0; b < SR_NUM_BANKS; ++b) {
+                std::vector<int> avail;
+                for (int r = b; r <= 64; r += SR_NUM_BANKS) {
+                    if (snap[r].valid) {
+                        avail.push_back(r);
+                    }
+                }
+                if (avail.empty()) continue;
+
+                int r_train = avail[prng_next() % avail.size()];
+                int s = r_train / SR_NUM_BANKS;
+                uint32_t d = snap[r_train].digest;
+
+                int p = 0;
+                int w0 = wt_idx(0, pc, d);
+                p += (2 * wt0[b][w0] + 1);
+                
+                int w1 = wt_idx(1, pc, d);
+                p += (2 * wt1[b][w1] + 1);
+                
+                int w2 = wt_idx(2, pc, d);
+                p += (2 * wt2[b][w2] + 1);
+
+                int rest = lsum - bank_contrib[b];
+                bool current_sign = (rest >= 0);
+                bool new_sign = ((rest + (int)(p * SR_MULTIPLIER_USEFUL)) >= 0);
+                
+                if (new_sign != current_sign) {
+                    bool match = ((p >= 0) == taken);
+                    for (int t = 0; t < 3; ++t) {
+                        int u = ut_idx(t, pc);
+                        sat_update(ut[b][t][u][s], match, SR_UT_CTR_BITS);
+                    }
+                }
+
+                sat_update(wt0[b][w0], taken, SR_WT_CTR_BITS);
+                sat_update(wt1[b][w1], taken, SR_WT_CTR_BITS);
+                sat_update(wt2[b][w2], taken, SR_WT_CTR_BITS);
+            }
+        }
+"""
+
+content = content.replace('    public:', sr_members)
+
+# Add setup initialization
+setup_new = """
+        void setup()
+        {
+            const char* e = getenv("SR_SR_ENABLE");
+            sr_enabled = (e != nullptr && e[0] == '1');
+            for (int r=0; r<=64; ++r) { reg_status[r].valid=false; reg_status[r].payload=0; reg_status[r].decay_ctr=0; }
+            for(int b=0;b<SR_NUM_BANKS;++b){
+                for(int t=0;t<3;++t){
+                    for(int u=0;u<SR_UT_ENTRIES;++u){
+                        for(int s=0;s<(65/SR_NUM_BANKS + 1);++s) ut[b][t][u][s] = 0;
+                    }
+                }
+                for(int w=0;w<SR_WT0_ENTRIES;++w) wt0[b][w] = 0;
+                for(int w=0;w<SR_WT1_ENTRIES;++w) wt1[b][w] = 0;
+                for(int w=0;w<SR_WT2_ENTRIES;++w) wt2[b][w] = 0;
+            }
+            prng_state = 123456789;
+        }
+"""
+content = content.replace('        void setup()\n        {\n        }', setup_new)
+
+content = content.replace('static SampleCondPredictor cond_predictor_impl;', 'extern SampleCondPredictor cond_predictor_impl;')
+
+with open('my_cond_branch_predictor.h', 'w') as f:
+    f.write(content)
+
