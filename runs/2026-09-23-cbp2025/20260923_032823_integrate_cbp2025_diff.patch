diff --git a/fix_decay.py b/fix_decay.py
new file mode 100644
index 0000000..4865c4b
--- /dev/null
+++ b/fix_decay.py
@@ -0,0 +1,37 @@
+import sys
+
+with open('my_cond_branch_predictor.h', 'r') as f:
+    content = f.read()
+
+orig_decode = """        void on_instruction_decode(int dest_reg, uint64_t rob_tag) {
+            for (int r = 0; r <= 64; ++r) {
+                if (reg_status[r].valid) {
+                    if (reg_status[r].decay_ctr == 0) {
+                        reg_status[r].valid = false;
+                    } else {
+                        reg_status[r].decay_ctr--;
+                    }
+                }
+            }"""
+
+new_decode = """        void on_instruction_decode(int dest_reg, uint64_t rob_tag) {
+            for (int r = 0; r <= 64; ++r) {
+                if (reg_status[r].valid) {
+                    if (reg_status[r].decay_ctr > 0) {
+                        reg_status[r].decay_ctr--;
+                        if (reg_status[r].decay_ctr == 0) {
+                            reg_status[r].valid = false;
+                        }
+                    } else {
+                        reg_status[r].valid = false;
+                    }
+                }
+            }"""
+
+if orig_decode in content:
+    content = content.replace(orig_decode, new_decode)
+    with open('my_cond_branch_predictor.h', 'w') as f:
+        f.write(content)
+    print("Fixed decay")
+else:
+    print("Could not find decode block")
