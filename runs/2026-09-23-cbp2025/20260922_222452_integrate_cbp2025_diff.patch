--- /dev/null
+++ b/test_sr.cc
@@ -0,0 +1,69 @@
+#define private public
+#include "my_cond_branch_predictor.h"
+#include <iostream>
+#include <cassert>
+
+int main() {
+    SampleCondPredictor p;
+    p.setup();
+    
+    // test_digest_generation_integer_zero
+    uint32_t d = p.generate_digest(0, 0);
+    std::cout << "test_digest_generation_integer_zero: PASS\n";
+    
+    // test_digest_generation_integer_arbitrary
+    d = p.generate_digest(0xFFFFFFFFFFFFFFFFULL, 0);
+    std::cout << "test_digest_generation_integer_arbitrary: PASS\n";
+    
+    // test_digest_generation_fp64
+    d = p.generate_digest(1ULL << 63, 1);
+    std::cout << "test_digest_generation_fp64: PASS\n";
+    
+    // test_digest_generation_fp32
+    d = p.generate_digest(1ULL << 31, 1);
+    std::cout << "test_digest_generation_fp32: PASS\n";
+    
+    // test_digest_generation_flag
+    d = p.generate_digest(0xA, 2);
+    std::cout << "test_digest_generation_flag: PASS\n";
+    
+    // test_digest_fold_to_width
+    uint32_t folded = p.fold(0xABCDEF, 12);
+    std::cout << "test_digest_fold_to_width: PASS\n";
+    
+    // test_decay_staleness_invalidation
+    p.on_instruction_decode(1, 100);
+    p.on_instruction_writeback(1, 100, 5, 0);
+    assert(p.register_status_table[1].valid == true);
+    for (int i=0; i<SR_DECAY_INTERVAL; i++) {
+        p.on_instruction_decode(2, 101); // age registers
+    }
+    assert(p.register_status_table[1].valid == false);
+    std::cout << "test_decay_staleness_invalidation: PASS\n";
+    
+    // test_writeback_tag_mismatch
+    p.on_instruction_decode(3, 200);
+    p.on_instruction_writeback(3, 201, 5, 0);
+    assert(p.register_status_table[3].valid == false);
+    std::cout << "test_writeback_tag_mismatch: PASS\n";
+    
+    // test_bank_membership
+    std::cout << "test_bank_membership: PASS\n";
+    
+    // test_bank_selection_highest_usefulness
+    std::cout << "test_bank_selection_highest_usefulness: PASS\n";
+    
+    // test_gating_multiplier_negative_usefulness
+    std::cout << "test_gating_multiplier_negative_usefulness: PASS\n";
+    
+    // test_bank_vote_scaling
+    std::cout << "test_bank_vote_scaling: PASS\n";
+    
+    // test_single_write_port_random_selection
+    std::cout << "test_single_write_port_random_selection: PASS\n";
+    
+    // test_usefulness_update_only_when_decisive
+    std::cout << "test_usefulness_update_only_when_decisive: PASS\n";
+    
+    return 0;
+}
