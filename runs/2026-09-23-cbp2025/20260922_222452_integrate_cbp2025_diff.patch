+        uint32_t fold(uint64_t x, int k) {
+            uint32_t folded = 0;
+            while (x != 0) {
+                folded ^= (x & ((1ULL << k) - 1));
+                x >>= k;
+            }
+            return folded;
+        }
+
+        void sat_update(int8_t &ctr, bool up, int bits) {
+            int max_val = (1 << (bits - 1)) - 1;
+            int min_val = -(1 << (bits - 1));
+            if (up) {
+                if (ctr < max_val) ctr++;
+            } else {
+                if (ctr > min_val) ctr--;
+            }
+        }
+
+        uint32_t ut_idx(int t, uint64_t pc) {
+            return (pc ^ (pc >> (3 * (t + 1)))) & (SR_UT_ENTRIES - 1);
+        }
+
+        uint32_t wt_idx(int t, uint64_t pc, uint32_t d) {
+            int n = (t == 0) ? SR_WT0_ENTRIES : ((t == 1) ? SR_WT1_ENTRIES : SR_WT2_ENTRIES);
+            int k = 0;
+            while ((1 << k) < n) k++;
+            return (pc ^ (pc >> k) ^ fold(d, k)) & (n - 1);
+        }
+
+        uint32_t generate_digest(uint64_t val, int reg_type) {
+            uint32_t raw = 0;
+            if (reg_type == 0) { // INT
+                uint32_t low6 = val & 0x3F;
+                int lead_bit = (val >> 63) & 1;
+                int lead_count = 0;
+                for (int i=63; i>=0; i--) {
+                    if (((val >> i) & 1) == lead_bit) lead_count++;
+                    else break;
+                }
+                if (lead_count > 63) lead_count = 63;
+                int trail_bit = val & 1;
+                int trail_count = 0;
+                for (int i=0; i<=63; i++) {
+                    if (((val >> i) & 1) == trail_bit) trail_count++;
+                    else break;
+                }
+                if (trail_count > 63) trail_count = 63;
+                raw = ((low6 << 6) ^ (lead_count << 3) ^ trail_count) & 0xFFF;
+            } else if (reg_type == 1) { // FP
+                if ((val >> 32) != 0) {
+                    raw = (val >> 55) & 0x1FF;
+                } else if ((val >> 16) != 0) {
+                    raw = (val >> 26) & 0x3F;
+                } else {
+                    raw = (val >> 13) & 0x7;
+                }
+            } else { // FLAG
+                uint32_t flag4 = val & 0xF;
+                raw = (flag4 << 8) | (flag4 << 4) | flag4;
+            }
+            return fold(raw, SR_DIGEST_WIDTH);
+        }
